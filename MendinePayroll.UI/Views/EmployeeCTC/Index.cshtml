    /* ===============================
       SAFE HTML ESCAPE
    ================================ */
    function escapeHtml(text) {
        return String(text ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    function formatDateForInput(value) {
        if (!value) return "";

        let date;
        let match = /\/Date\((\d+)\)\//.exec(String(value));

        if (match) {
            date = new Date(parseInt(match[1], 10));
        } else {
            date = new Date(value);
        }

        if (isNaN(date.getTime())) return "";

        const yyyy = date.getFullYear();
        const mm = String(date.getMonth() + 1).padStart(2, '0');
        const dd = String(date.getDate()).padStart(2, '0');
        return `${yyyy}-${mm}-${dd}`;
    }

    function getCurrentMonthStartDate() {
        const date = new Date();
        date.setDate(1);

        const yyyy = date.getFullYear();
        const mm = String(date.getMonth() + 1).padStart(2, '0');
        return `${yyyy}-${mm}-01`;
    }

    function openSalaryDetailsModal(button) {
        const $button = $(button);
        const empId = $button.data('empid');
        const empSalaryConfigID = $button.data('empsalaryconfigid') || 0;
        const empName = $button.data('empname') || "--";
        const payGroupId = $button.data('paygroupid') || "";
        const payGroupName = $button.data('paygroupname') || "--";

        salaryDetailState = {
            empId: empId,
            empSalaryConfigID: empSalaryConfigID,
            empName: empName,
            payGroupId: payGroupId,
            payGroupName: payGroupName,
            currentConfig: [],
            componentValuesById: {}
        };

        resetSalaryDetailsModal(empName, payGroupId, payGroupName);
        $('#salaryDetailsModal').show();

        if (!empSalaryConfigID || empSalaryConfigID === "0") {
            $('#salaryDetailsLoader').hide();
            $('#salaryDetailsContent').show();
            loadSalaryDetailPayGroupComponents(payGroupId);
            return;
        }

        $.ajax({
            url: '/SalaryCTC/GetEmployeeSalaryConfig',
            type: 'GET',
            data: {
                empSalaryConfigID: empSalaryConfigID,
                EmployeeID: empId
            },
            success: function (res) {
                if (!res || !res.Success || !res.Data) {
                    $('#salaryDetailsLoader').text(res && res.Message ? res.Message : 'Salary details are not available.');
                    return;
                }

                bindSalaryDetails(res.Data, empName, payGroupId, payGroupName);
            },
            error: function () {
                $('#salaryDetailsLoader').text('Failed to load salary details.');
            }
        });
    }

    function resetSalaryDetailsModal(empName, payGroupId, payGroupName) {
        $('#salaryDetailsLoader').text('Loading salary details...').show();
        $('#salaryDetailsContent').hide();
        $('#detailEmpName').text(empName || "--");
        buildSalaryDetailPayGroupOptions(payGroupId, payGroupName);
        $('#detailEffectiveFromInput').val(getCurrentMonthStartDate());
        $('#detailPF, #detailESIC, #detailPTAX').prop('checked', false);
        $('#salaryManualBody, #salaryAllowanceBody, #salaryDeductionBody').empty();
        $('#salaryNoManual, #salaryNoAllowance, #salaryNoDeduction').hide();
    }

    function buildSalaryDetailPayGroupOptions(payGroupId, payGroupName) {
        const $select = $('#detailPayGroupSelect');
        $select.empty();

        $('#ddlgroup option').each(function () {
            const value = $(this).attr('value') || "";
            const text = $(this).text();
            if (value) {
                $select.append(`<option value="${escapeHtml(value)}">${escapeHtml(text)}</option>`);
            }
        });

        if (payGroupId && !$select.find(`option[value="${payGroupId}"]`).length) {
            $select.append(`<option value="${escapeHtml(payGroupId)}">${escapeHtml(payGroupName || payGroupId)}</option>`);
        }

        $select.val(payGroupId || "");
    }

    function bindSalaryDetails(data, empName, payGroupId, payGroupName) {
        const header = data.Header || {};
        const detailList = data.DetailList || [];
        const selectedPayGroupId = String(header.PayGroupID || payGroupId || "");

        $('#detailEmpName').text(empName || "--");
        buildSalaryDetailPayGroupOptions(selectedPayGroupId, payGroupName);
        $('#detailEffectiveFromInput').val(getCurrentMonthStartDate());

        $('#detailPF').prop('checked', !!header.IsPF_Applicable);
        $('#detailESIC').prop('checked', !!header.IsESIC_Applicable);
        $('#detailPTAX').prop('checked', !!header.IsPTAX_Applicable);

        salaryDetailState.currentConfig = data.Template || detailList || [];
        cacheSalaryDetailComponentValues(detailList);
        renderSalaryDetailComponents(getExistingSalaryDetailComponents(detailList));

        $('#salaryDetailsLoader').hide();
        $('#salaryDetailsContent').show();
    }

    function normalizePayType(value) {
        return String(value || '').trim().toLowerCase();
    }

    function normalizeLogicType(value) {
        return String(value || '').trim().toUpperCase();
    }

    function normalizeStatutoryType(value) {
        return String(value || '').trim().toUpperCase();
    }

    function isSalaryDetailComponent(item) {
        const payType = normalizePayType(item.PayType);
        const logicType = normalizeLogicType(item.LogicType);
        const statutoryType = normalizeStatutoryType(item.StatutoryType);

        if (payType === "deduction" && statutoryType === "PTAX") {
            return false;
        }

        return (payType === "manual" || payType === "allowances" || payType === "deduction") && logicType === "FIXED";
    }

    function getExistingSalaryDetailComponents(detailList) {
        return (detailList || []).filter(x => {
            return isSalaryDetailComponent(x);
        });
    }

    function cacheSalaryDetailComponentValues(detailList) {
        (detailList || []).filter(isSalaryDetailComponent).forEach(item => {
            const amount = parseMoney(item.MonthlyAmount);
            const id = String(item.PayConfigId || "");

            if (id) salaryDetailState.componentValuesById[id] = amount;
        });
    }

    function renderSalaryDetailComponents(components) {
        const groups = {
            manual: [],
            allowances: [],
            deduction: []
        };

        (components || []).forEach(item => {
            const payType = normalizePayType(item.PayType);
            if (groups[payType]) {
                groups[payType].push(item);
            }
        });

        renderSalaryDetailTable('#salaryManualBody', '#salaryNoManual', groups.manual);
        renderSalaryDetailTable('#salaryAllowanceBody', '#salaryNoAllowance', groups.allowances);
        renderSalaryDetailTable('#salaryDeductionBody', '#salaryNoDeduction', groups.deduction);
    }

    function renderSalaryDetailTable(bodySelector, emptySelector, components) {
        const $tbody = $(bodySelector);
        $tbody.empty();

        (components || []).forEach(item => {
            const amount = getSalaryDetailAmount(item);
            $tbody.append(`
                <tr>
                    <td>${escapeHtml(item.PayConfigName)}</td>
                    <td>
                        <input type="number"
                            class="form-control-saas salary-detail-allowance-input"
                            style="width:130px; text-align:right;"
                            step="0.01"
                            data-payconfigid="${escapeHtml(item.PayConfigId)}"
                            data-payconfigname="${escapeHtml(item.PayConfigName)}"
                            value="${formatMoney(amount)}"
                            oninput="captureSalaryDetailAllowanceInputs()" />
                    </td>
                </tr>
            `);
        });

        $(emptySelector).toggle(!components || components.length === 0);
        $tbody.closest('table').toggle(!!components && components.length > 0);
    }

    function getSalaryDetailAmount(item) {
        const id = String(item.PayConfigId || "");

        if (id && salaryDetailState.componentValuesById[id] !== undefined) {
            return salaryDetailState.componentValuesById[id];
        }

        return parseMoney(item.MonthlyAmount);
    }

    function captureSalaryDetailAllowanceInputs() {
        $('.salary-detail-allowance-input').each(function () {
            const id = String($(this).data('payconfigid') || "");
            const amount = parseMoney($(this).val());

            if (id) salaryDetailState.componentValuesById[id] = amount;
        });
    }

    function handleSalaryDetailPayGroupChange() {
        captureSalaryDetailAllowanceInputs();
        const payGroupId = $('#detailPayGroupSelect').val();
        salaryDetailState.payGroupId = payGroupId;
        loadSalaryDetailPayGroupComponents(payGroupId);
    }

    function loadSalaryDetailPayGroupComponents(payGroupId) {
        if (!payGroupId) {
            renderSalaryDetailComponents([]);
            return;
        }

        $('#salaryDetailsLoader').text('Loading paygroup components...').show();

        $.ajax({
            url: '/SalaryCTC/GetSalaryConfigByPayGroup',
            type: 'GET',
            data: { payGroupId: payGroupId },
            success: function (res) {
                salaryDetailState.currentConfig = res || [];
                const components = (res || []).filter(isSalaryDetailComponent);
                renderSalaryDetailComponents(components);
            },
            error: function () {
                renderSalaryDetailComponents([]);
                toastr.error("Failed to load paygroup components.");
            },
            complete: function () {
                $('#salaryDetailsLoader').hide();
                $('#salaryDetailsContent').show();
            }
        });
    }

    function getSalaryDetailPayloadValues() {
        captureSalaryDetailAllowanceInputs();

        return $('.salary-detail-allowance-input').map(function () {
            return {
                AllowanceId: parseInt($(this).data('payconfigid') || 0),
                Value: parseMoney($(this).val())
            };
        }).get().filter(x => x.AllowanceId > 0);
    }

    function saveSalaryDetailsModal() {
        const payload = {
            EmployeeID: parseInt(salaryDetailState.empId || 0),
            PayGroupID: parseInt($('#detailPayGroupSelect').val() || 0),
            EmpSalaryConfigID: parseInt(salaryDetailState.empSalaryConfigID || 0),
            EffectiveFrom: $('#detailEffectiveFromInput').val(),
            IsPF: $('#detailPF').is(':checked'),
            IsESIC: $('#detailESIC').is(':checked'),
            IsPTAX: $('#detailPTAX').is(':checked'),
            Allowances: getSalaryDetailPayloadValues()
        };

        if (!payload.EmployeeID || !payload.PayGroupID) {
            toastr.error("Employee and PayGroup are required.");
            return;
        }

        $('#salaryDetailsLoader').text('Sending salary details...').show();

        $.ajax({
            url: '/EmployeeCTC/SaveSalaryDetailsComponents',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (res) {
                if (res && res.Success) {
                    toastr.success(res.Message || "Salary details sent successfully.");
                    salaryDetailState.empSalaryConfigID = res.EmpSalaryConfigID || salaryDetailState.empSalaryConfigID;
                    closeSalaryDetailsModal();
                    loadEmployees();
                } else {
                    toastr.error(res && res.Message ? res.Message : "Unable to send salary details.");
                }
            },
            error: function () {
                toastr.error("Server error while sending salary details.");
            },
            complete: function () {
                $('#salaryDetailsLoader').hide();
            }
        });
    }


    function closeSalaryDetailsModal() {
        captureSalaryDetailAllowanceInputs();
        $('#salaryDetailsModal').fadeOut(200);
    }

