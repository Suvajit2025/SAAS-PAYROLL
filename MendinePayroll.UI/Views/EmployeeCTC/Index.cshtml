<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-multiselect/0.9.15/js/bootstrap-multiselect.min.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<script>
    let allEmployees = [];   // 🔐 master copy (never mutate)
    let dt = null;
    let lastCalculatedData = null;
    let curConfig = []; 

    $(document).ready(function () {

        // 1. Init Multiselects
        $('#ddlCompany, #ddlDepartment, #ddlCategory ,#ddlpaygroup').multiselect({

            includeSelectAllOption: true,
            enableFiltering: true,
            enableCaseInsensitiveFiltering: true,
            filterPlaceholder: 'Search here...',
            nonSelectedText: 'Select Options',
            buttonWidth: '100%',
            buttonClass: 'btn btn-default btn-sm dropdown-toggle',
            maxHeight: 300,
            selectAllText: 'Select All',
            allSelectedText: 'All Selected',
            nSelectedText: 'Selected',
            numberDisplayed: 2,
            templates: {
                ul: '<ul class="multiselect-container dropdown-menu" style="min-width:250px; max-height:300px; overflow:auto;"></ul>'
            }
        });

        // 2. Load All FIlters
        loadFilters();
        // 🔑 force default
        $('#ddlstatus').val('ACTIVE');
        loadEmployees();
        //$('#btnFilter').on('click', applyFilters);
        $('#ddlCompany, #ddlDepartment, #ddlCategory, #ddlstatus ,#ddlpaygroup')
            .on('change', applyFilters);
        $('#chkPF, #chkESIC, #chkPTAX').on('change', function () {
            callBackendCalculation();
        });
    });
    // ===================== AJAX LOAD DROPDOWNS =====================
    function loadFilters() {

        // ----------- LOAD COMPANY -----------
        $.ajax({
            url: '/SalaryCTC/GetCompanyList',
            type: 'GET',
            success: function (res) {
                $('#ddlCompany').empty();
                res.forEach(x => {
                    $('#ddlCompany').append(`<option value="${x.CompanyId}">${x.CompanyName}</option>`);
                });

                $('#ddlCompany').multiselect('rebuild'); // refresh
            }
        });

        // ----------- LOAD DEPARTMENT -----------
        $.ajax({
            url: '/SalaryCTC/GetDepartmentList',
            type: 'GET',
            success: function (res) {
                $('#ddlDepartment').empty();
                res.forEach(x => {
                    $('#ddlDepartment').append(`<option value="${x.DepartmentID}">${x.DepartmentName}</option>`);
                });

                $('#ddlDepartment').multiselect('rebuild');
            }
        });

        // ----------- LOAD CATEGORY -----------
        $.ajax({
            url: '/SalaryCTC/GetCategoryList',
            type: 'GET',
            success: function (res) {
                $('#ddlCategory').empty();
                res.forEach(x => {
                    $('#ddlCategory').append(`<option value="${x.CategoryID}">${x.CategoryName}</option>`);
                });

                $('#ddlCategory').multiselect('rebuild');
            }
        });
        // ----------- LOAD PAY GROUP -----------
        $.ajax({
            url: '/SalaryCTC/GetPayGroupList',
            type: 'GET',
            success: function (res) {
                $("#ddlpaygroup").empty();

                res.forEach(x => {
                    $('#ddlpaygroup').append(
                        `<option value="${x.PayGroupID}">${x.PayGroupName}</option>`
                    );
                });

                // 🔑 THIS WAS MISSING
                $('#ddlpaygroup').multiselect('rebuild');
            }
        });
        // ----------- LOAD PAY GROUP category wise-----------
        $.ajax({
            url: '/SalaryCTC/GetPayGroupListConfigWise',
            type: 'GET',
            success: function (res) {
                $("#ddlgroup").empty();
                $("#ddlgroup").append('<option value="">--Select PayGroup--</option>');
                res.forEach(x => {
                    $('#ddlgroup').append(
                        `<option value="${x.PayGroupID}">${x.PayGroupName}</option>`
                    );
                });

            }
        });

    }
    /* ===============================
       LOAD DATA FROM SERVER (ONCE)
    ================================ */
    function loadEmployees() {
        // 1. Show the table loader
        $('#tableLoader').css('display', 'flex').fadeIn(100);

        // 2. Clear current table data to show it's refreshing
        if (dt) {
            dt.clear().draw();
        }
        var companyIds = $('#ddlCompany').val() || [];
        var deptIds = $('#ddlDepartment').val() || [];
        var categoryIds = $('#ddlCategory').val() || [];

        $.ajax({
            url: '/SalaryCTC/GetEmployeeList',
            type: 'GET',
            traditional: true,
            data: {
                companyIds: companyIds,
                deptIds: deptIds,
                categoryIds: categoryIds
            },
            success: function (data) {
                allEmployees = data || [];
                applyFilters();   // 🔑 client-side filter
            },
            error: function () {
                toastr.error("Failed to load employee data.");
            },
            complete: function () {
                // 3. Hide the table loader
                $('#tableLoader').fadeOut(200);
            }
        });
    }
    /* ===============================
       APPLY CLIENT-SIDE FILTERS
    ================================ */
    function applyFilters() {

        let companyIds = ($('#ddlCompany').val() || []).map(v => String(v));
        let deptIds = ($('#ddlDepartment').val() || []).map(v => String(v));
        let categoryIds = ($('#ddlCategory').val() || []).map(v => String(v));
        let paygroupIds = ($('#ddlpaygroup').val() || []).map(v => String(v));
        let status = $('#ddlstatus').val() || 'ACTIVE';

        let filtered = allEmployees.filter(emp => {

            const empStatus = String(emp.Empstatus ?? '');
            const empCompany = String(emp.CompanyID ?? '');
            const empDept = String(emp.DepartmentID ?? '');
            const empCategory = String(emp.CategoryID ?? '');
            const empPayGroup = String(emp.PayGroupID ?? '');

            // Status
            if (status !== 'All' && empStatus !== status)
                return false;

            // Company
            if (companyIds.length && !companyIds.includes(empCompany))
                return false;

            // Department
            if (deptIds.length && !deptIds.includes(empDept))
                return false;

            // Category
            if (categoryIds.length && !categoryIds.includes(empCategory))
                return false;

            // Pay Group
            if (paygroupIds.length && !paygroupIds.includes(empPayGroup))
                return false;

            return true;
        });

        renderTable(filtered);
    }
    /* ===============================
       RENDER DATATABLE
    ================================ */
    function renderTable(data) {

        if (dt) {
            dt.destroy();
            dt = null;
        }

        let tbody = $('#emptable tbody');
        tbody.empty();

        data.forEach((emp, index) => {

            let badgeClass =
                emp.Status === "Configured" ? "badge-done" : "badge-pending";

            tbody.append(`
        <tr>
            <td>${index + 1}</td>
            <td>
                <div class="tbl-text">${escapeHtml(emp.EmpName)}</div>
                <div class="tbl-text-muted">${escapeHtml(emp.EmpCode)}</div>
            </td>

            <td>
                <div class="tbl-text">${escapeHtml(emp.Designation)}</div>
                <div class="tbl-text-muted">${escapeHtml(emp.Post)}</div>
            </td>
            <td>
            <div class="tbl-text">${escapeHtml(emp.Department)}</div> 
            </td>
            <td>
            <div class="tbl-text">${escapeHtml(emp.PayGroupName ?? '-')}</div>
            </td>
            <td>
                <span class="badge-saas ${badgeClass}">
                    ${escapeHtml(emp.Status)}
                </span>
            </td>
            <td>
                <button class="btn-link-saas"
                    onclick="openModal('${escapeHtml(emp.EmpName)}','${emp.EmpID}','${emp.EmpSalaryConfigID}')">
                    <i class="fas fa-cog"></i> Configure
                </button>
            </td>
        </tr>
    `);
        });

        dt = $('#emptable').DataTable({
            pageLength: 10,
            searching: true,
            lengthChange: false,

            ordering: true,   // keep ordering ON globally

            columnDefs: [
                {
                    targets: '_all',
                    orderable: false   // ❌ disable sorting for all columns
                },
                {
                    targets: 0,
                    orderable: true    // ✅ enable sorting ONLY for SL column
                }
            ],

            language: {
                search: "",
                searchPlaceholder: "Search employee..."
            }
        });

    }

    /* ===============================
       SAFE HTML ESCAPE
    ================================ */
    function escapeHtml(text) {
        return String(text ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    // ================= OPEN MODAL =================
    function openModal(empName, empId, empSalaryConfigID) {

        $('#modalEmpName').text(empName);
        $('#hdnSelectedEmpId').val(empId);
        $('#hdnEmpSalaryConfigID').val(empSalaryConfigID || 0);

        let d = new Date();
        d.setMonth(d.getMonth() - 1);
        d.setDate(1);

        $('#txtEffectiveFrom').val(d.toISOString().split('T')[0]);

        $('#ctcModal').show();

        // Reset UI
        $('#inputPanel').html('<small>Select PayGroup to start...</small>');
        $('#tbody_earnings, #tbody_deductions, #tbody_contribution').empty();

        //$('#lblTotalGross, #lblTotalGrossYear').text(0);
        //$('#lblTotalDed, #lblTotalDedYear').text(0);
        //$('#lblTotalContrib, #lblTotalContribYear').text(0);
        //$('#lblNetPay, #lblCTCMonth, #lblCTCYear').text("₹ 0");

        loadEmployeeSalary(empSalaryConfigID, empId);
        //lastCalculatedData = null;
    }
    //==================LOAD SALARY=============
    function loadEmployeeSalary(empSalaryConfigID, empId) {
        //$('#modalLoader').css('display', 'flex').fadeIn(100);
        $.ajax({
            url: '/SalaryCTC/GetEmployeeSalaryConfig',
            type: 'GET',
            data: {
                empSalaryConfigID: empSalaryConfigID || 0,
                EmployeeID: empId
            },

            success: function (res) {

                // ❌ No data → open blank template
                if (!res.Success) {
                    renderTemplate(); // existing method
                    return;
                }

                let data = res.Data;

                // 🔥 SET PAYGROUP
                $('#ddlgroup').val(data.Header.PayGroupID);

                // 🔥 SET CHECKBOX
                $('#chkPF').prop('checked', data.Header.IsPF_Applicable);
                $('#chkESIC').prop('checked', data.Header.IsESIC_Applicable);
                $('#chkPTAX').prop('checked', data.Header.IsPTAX_Applicable);

                // 🔥 BUILD curConfig from TEMPLATE
                curConfig = data.Template.map(x => ({
                    id: x.PayConfigId,
                    name: x.PayConfigName,
                    type: x.PayType === "Allowances" ? "Add"
                        : x.PayType === "Deduction" ? "Ded"
                            : "Cont",

                    isInput: x.PayType === "Manual" || x.IsGrossComponent,
                    isManual: x.LogicType === "FIXED" && !x.IsStatutory,
                    isStatutory: x.IsStatutory,

                    isBasic: x.IsBasicComponent,
                    isGross: x.IsGrossComponent,

                    formula: x.CalculationFormula,
                    logic: x.LogicType,
                    rate: x.ManualRate
                }));

                // 🔥 DRAW TEMPLATE
                drawTemplate(true);

                // 🔥 FILL VALUES AFTER DRAW
                requestAnimationFrame(() => {
                    bindExistingValues(data.DetailList, data.Header);
                });
                //setTimeout(() => {
                //    bindExistingValues(data.DetailList, data.Header);
                //}, 200);
            },

            error: function () {
                toastr.error("Failed to load salary");
                renderTemplate();
            },
            complete: function () {
                // Hide Modal Loader
                $('#modalLoader').fadeOut(300);
            }
        });
    }
    //=================VALUE BINDING============
    function bindExistingValues(details, header) {
        console.log(details);
        if (!details || !details.length) return;

        details.forEach(x => {

            let input = document.getElementById(x.PayConfigId);
            let manual = document.getElementById("val_" + x.PayConfigId);

            // 🔥 INPUT PANEL (GROSS etc)
            if (input) {
                input.value = x.MonthlyAmount;
            }

            // 🔥 GRID MANUAL (FIXED fields)
            if (manual && manual.classList.contains('inp-manual')) {
                manual.value = x.MonthlyAmount;
            }

            // 🔥 GRID CALCULATED
            let calcBox = document.getElementById("val_" + x.PayConfigId);
            if (calcBox && !calcBox.classList.contains('inp-manual')) {
                calcBox.value = x.MonthlyAmount;
            }

            // 🔥 YEAR
            let yr = document.getElementById("yr_" + x.PayConfigId);
            if (yr) {
                yr.innerText = x.YearlyAmount;
            }
        });

        // HEADER
        $('#lblTotalGross').text(header.MonthlyGross);
        $('#lblTotalGrossYear').text(header.MonthlyGross * 12);

        $('#lblTotalDed').text(header.TotalDeduction);
        $('#lblTotalDedYear').text(header.TotalDeduction * 12);

        $('#lblTotalContrib').text(header.TotalContribution);
        $('#lblTotalContribYear').text(header.TotalContribution * 12);

        $('#lblNetPay').text("₹ " + header.NetPay);
        $('#lblCTCMonth').text("₹ " + header.MonthlyCTC);
        $('#lblCTCYear').text("₹ " + header.AnnualCTC);

        lastCalculatedData = {
            Header: header,
            DetailList: details
        };
    }
    // ================= CLOSE =================
    function closeModal() {

        $('#ctcModal').fadeOut(200, function () {

            // =========================
            // 1) CLEAR ENTIRE MODAL
            // =========================

            // Inputs & tables
            $('#inputPanel').empty().hide();
            $('#tbody_earnings').empty();
            $('#tbody_deductions').empty();
            $('#tbody_contribution').empty();

            // Hidden fields
            $('#hdnSelectedEmpId').val("0");
            $('#hdnEmpSalaryConfigID').val("0");

            // Dropdowns
            $("#ddlgroup").val("");

            // Header name
            $("#modalEmpName").text("--");

            // Totals
            $('#lblTotalGross').text("0");
            $('#lblTotalGrossYear').text("0");

            $('#lblTotalDed').text("0");
            $('#lblTotalDedYear').text("0");

            $('#lblTotalContrib').text("0");
            $('#lblTotalContribYear').text("0");

            $('#lblNetPay').text("₹ 0");
            $('#lblCTCMonth').text("₹ 0");
            $('#lblCTCYear').text("₹ 0");

            // Checkboxes
            $('#chkPF').prop('checked', true);
            $('#chkESIC').prop('checked', true);
            $('#chkPTAX').prop('checked', true);

            // Global JS cache
            curConfig = [];

            // =========================
            // OPTIONAL: Reload employee list
            // =========================
            //loadEmployees();
        });
    }

    // ================= TEMPLATE LOAD =================
    function renderTemplate() {

        let payGroupId = $('#ddlgroup').val();
        if (!payGroupId) return;

        $.ajax({
            url: '/SalaryCTC/GetSalaryConfigByPayGroup',
            type: 'GET',
            data: { payGroupId: payGroupId },
            success: function (res) {

                curConfig = res.map(x => ({
                    id: x.PayConfigId,
                    name: x.PayConfigName,
                    type: x.PayType === "Allowances" ? "Add"
                        : x.PayType === "Deduction" ? "Ded"
                            : x.PayType === "CC" ? "Cont"
                                : "Manual",

                    isInput: x.PayType === "Manual" || x.IsGrossComponent,
                    isManual: x.LogicType === "FIXED" && x.PayType !== "Manual" && !x.IsStatutory,
                    isBasic: x.IsBasicComponent,
                    isGross: x.IsGrossComponent,

                    formula: x.CalculationFormula,
                    logic: x.LogicType,
                    rate: x.ManualRate
                }));

                drawTemplate(false);
            }
        });
    }

    //=============== TEMPLATE DRAW =====================
    function drawTemplate(isEditMode = false) {

        let inputsHtml = "";
        let hasInputs = false;

        curConfig.filter(x => x.isInput).forEach(x => {

            hasInputs = true;

            inputsHtml += `
        <div class="col-md-12 mb-3">
            <label style="font-size:12px; font-weight:600; color:#0E7777;">
                ${x.name}
            </label>

            <input type="number"
                   id="${x.id}"
                   class="form-control input-gross"
                   data-payconfigid="${x.id}"
                   data-payconfigname="${x.name}"
                   data-logic="${x.logic}"
                   value=""
                   oninput="handleInputChange(this)" />
        </div>`;
        });

        if (hasInputs)
            $('#inputPanel').html(`<div class="row-class-new border-bottom">${inputsHtml}</div>`).show();
        else
            $('#inputPanel').hide();

        // ===== TABLE =====
        $('#tbody_earnings, #tbody_deductions, #tbody_contribution').empty();

        curConfig.filter(x => !x.isInput).forEach(x => {

            let inp = "";

            if (x.isManual || x.logic === "EXCEL_UPLOAD") {
                inp = `<input type="text"
                          id="val_${x.id}"
                          class="inp-manual form-control text-end"
                          data-payconfigid="${x.id}"
                          data-payconfigname="${x.name}"
                          data-logic="${x.logic}"
                          value="${x.rate || 0}"
                          oninput="handleInputChange(this)" />`;
            } else {
                inp = `<input type="text"
                          id="val_${x.id}"
                          class="form-control-plaintext text-end"
                          value="" readonly />`;
            }

            let row = `
        <tr>
            <td>${x.name}</td>
            <td>${x.formula || ''}</td>
            <td>${inp}</td>
            <td id="yr_${x.id}" class="text-end">0</td>
        </tr>`;

            if (x.type === "Add") $('#tbody_earnings').append(row);
            if (x.type === "Ded") $('#tbody_deductions').append(row);
            if (x.type === "Cont") $('#tbody_contribution').append(row);
        });

        // 🔥 FIRST CALCULATION
        if (!isEditMode) {
            setTimeout(() => {
                callBackendCalculation();
            }, 200);
        }
    }

    //==================INPUT HANDLER===================
    let calcTimer;

    function handleInputChange(el) {

        let val = parseFloat($(el).val()) || 0;
        $(el).val(val);

        clearTimeout(calcTimer);

        calcTimer = setTimeout(() => {
            callBackendCalculation();
        }, 300);
    }
    // ================= CALL BACKEND =================
    function callBackendCalculation() {

        let inputs = [];

        // Top input panel values
        $('#inputPanel input').each(function () {
            inputs.push({
                PayConfigId: parseInt($(this).data('payconfigid') || 0),
                PayConfigName: $(this).data('payconfigname') || "",
                logic: $(this).data('logic') || "",
                MonthlyAmount: parseFloat($(this).val()) || 0
            });
        });

        // Manual grid values
        $('.inp-manual').each(function () {
            inputs.push({
                PayConfigId: parseInt($(this).data('payconfigid') || 0),
                PayConfigName: $(this).data('payconfigname') || "",
                logic: $(this).data('logic') || "",
                MonthlyAmount: parseFloat($(this).val()) || 0
            });
        });

        let payload = {
            EmployeeID: parseInt($('#hdnSelectedEmpId').val() || 0),
            PayGroupID: parseInt($('#ddlgroup').val() || 0),
            EmpSalaryConfigID: parseInt($('#hdnEmpSalaryConfigID').val() || 0),

            IsPF: $('#chkPF').is(':checked'),
            IsESIC: $('#chkESIC').is(':checked'),
            IsPTAX: $('#chkPTAX').is(':checked'),

            Inputs: inputs
        };

        if (!payload.EmployeeID || !payload.PayGroupID) return;

        $.ajax({
            url: '/EmployeeCTC/CalculateEmployeeCTC',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (res) {
                if (!res.Success) {
                    toastr.error(res.Message || "Calculation failed");
                    return;
                }

                bindCalculationResult(res.Data);
            },
            error: function () {
                toastr.error("Server error while calculating.");
            }
        });
    }

