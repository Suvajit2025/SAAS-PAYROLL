    function bindCalculationResult(data) {

        if (!data) {
            console.warn("bindCalculationResult: data is null/undefined");
            return;
        }

        console.log("=== BIND START ===");
        console.log("DetailList:", data.DetailList);
        console.log("Header:", data.Header);

        (data.DetailList || []).forEach(x => {

            let monthlyBox = $(`#val_${x.PayConfigId}`);
            let yearlyBox = $(`#yr_${x.PayConfigId}`);

            // 🔥 Get logic from DOM
            let logic = (monthlyBox.data('logic') || "").toString().toUpperCase();

            // 🔍 DOM checks
            let domVal = monthlyBox.length ? monthlyBox.val() : undefined;

            console.group(`PayConfigId: ${x.PayConfigId}`);
            console.log("Backend -> Monthly:", x.MonthlyAmount, "Yearly:", x.YearlyAmount);
            console.log("DOM -> Exists:", monthlyBox.length > 0, "Current Val:", domVal);
            console.log("Logic (DOM):", logic);

            const isCalculatedComponent =
                !monthlyBox.hasClass('inp-manual') &&
                logic !== "EXCEL_UPLOAD";

            // ================= MONTHLY =================
            if (monthlyBox.length) {

                let currentVal = monthlyBox.val();

                if (logic === "EXCEL_UPLOAD") {

                    console.log("Branch: EXCEL_UPLOAD");

                    if (currentVal === "" || currentVal === "0") {
                        const roundedMonthly =
                            roundMoney(x.MonthlyAmount);

                        console.log("Setting Monthly from backend:", roundedMonthly);
                        x.MonthlyAmount = roundedMonthly;
                        monthlyBox.val(formatRoundedMoney(roundedMonthly));
                    } else {
                        console.log("Skipping overwrite (user value kept):", currentVal);
                    }
                }
                else if (isCalculatedComponent) {

                    const roundedMonthly =
                        roundMoney(x.MonthlyAmount);

                    console.log("Branch: Calculated field -> set Monthly:", roundedMonthly);
                    x.MonthlyAmount = roundedMonthly;
                    monthlyBox.val(formatRoundedMoney(roundedMonthly));
                }
                else {
                    console.log("Branch: Manual FIXED -> skip overwrite");
                }
            } else {
                console.warn("Monthly input NOT FOUND for:", x.PayConfigId);
            }

            // ================= YEARLY =================
            if (yearlyBox.length) {

                let yearly = parseMoney(x.YearlyAmount);

                if (logic === "EXCEL_UPLOAD") {

                    // 🔥 take value from input (NOT backend)
                    let domVal = parseMoney(monthlyBox.val());
                    yearly = roundMoney(domVal * 12);
                    x.YearlyAmount = yearly;

                    console.log("EXCEL_UPLOAD Yearly from DOM:", yearly);
                }
                else {
                    if (!yearly || yearly === 0) {
                        yearly = roundMoney(x.MonthlyAmount * 12);
                        console.log("Yearly fallback used:", yearly);
                    } else {
                        yearly = roundMoney(yearly);
                        console.log("Yearly from backend:", yearly);
                    }
                }

                x.YearlyAmount = yearly;
                yearlyBox.text(formatRoundedMoney(yearly));
            }

            console.groupEnd();
        });

        // ================= HEADER =================
        console.log("Header Bind:");
        console.log("Gross:", data.Header.MonthlyGross);
        console.log("Deduction:", data.Header.TotalDeduction);
        console.log("Contribution:", data.Header.TotalContribution);
        console.log("Net:", data.Header.NetPay);

        data.Header.MonthlyGross =
            roundMoney(data.Header.MonthlyGross);
        data.Header.TotalDeduction =
            roundMoney(data.Header.TotalDeduction);
        data.Header.TotalContribution =
            roundMoney(data.Header.TotalContribution);
        data.Header.NetPay =
            roundMoney(data.Header.NetPay);
        data.Header.MonthlyCTC =
            roundMoney(data.Header.MonthlyCTC);
        data.Header.AnnualCTC =
            roundMoney(data.Header.AnnualCTC);

        setMoneyText('#lblTotalGross', data.Header.MonthlyGross);
        setMoneyText('#lblTotalGrossYear', roundMoney(data.Header.MonthlyGross * 12));

        setMoneyText('#lblTotalDed', data.Header.TotalDeduction);
        setMoneyText('#lblTotalDedYear', roundMoney(data.Header.TotalDeduction * 12));

        setMoneyText('#lblTotalContrib', data.Header.TotalContribution);
        setMoneyText('#lblTotalContribYear', roundMoney(data.Header.TotalContribution * 12));

        setRupeeCurrencyText('#lblNetPay', data.Header.NetPay);
        setRupeeCurrencyText('#lblCTCMonth', data.Header.MonthlyCTC);
        setRupeeCurrencyText('#lblCTCYear', data.Header.AnnualCTC);

        lastCalculatedData = data;

        console.log("=== BIND END ===");
    }
    // ================= SAVE =================
    function saveData() {

        if (!lastCalculatedData) {
            toastr.error("Please calculate first");
            return;
        }
        let finalDetails = (lastCalculatedData.DetailList || []).map(item => {

            let inputBox = $(`#val_${item.PayConfigId}`);
            let logic = (inputBox.data('logic') || "").toString().toUpperCase();

            // 🔥 If EXCEL_UPLOAD → take from UI
            if (logic === "EXCEL_UPLOAD" && inputBox.length) {

                let domVal = parseMoney(inputBox.val());

                return {
                    ...item,
                    MonthlyAmount: domVal,
                    YearlyAmount: parseMoney(domVal * 12)
                };
            }

            return item;
        });
        let payload = {
            EmployeeID: parseInt($('#hdnSelectedEmpId').val() || 0),
            PayGroupID: parseInt($('#ddlgroup').val() || 0),
            EmpSalaryConfigID: parseInt($('#hdnEmpSalaryConfigID').val() || 0),

            // ✅ IMPORTANT
            EffectiveFrom: $('#txtEffectiveFrom').val(),

            IsPF: $('#chkPF').is(':checked'),
            IsESIC: $('#chkESIC').is(':checked'),
            IsPTAX: $('#chkPTAX').is(':checked'),

            // ✅ FROM BACKEND CALCULATION
            MonthlyGross: lastCalculatedData.Header.MonthlyGross,
            TotalAllowance: lastCalculatedData.Header.Allowances,
            TotalDeduction: lastCalculatedData.Header.TotalDeduction,
            TotalContribution: lastCalculatedData.Header.TotalContribution,
            NetPay: lastCalculatedData.Header.NetPay,
            MonthlyCTC: lastCalculatedData.Header.MonthlyCTC,
            AnnualCTC: lastCalculatedData.Header.AnnualCTC,

            DetailList: finalDetails
            //DetailList: lastCalculatedData.DetailList
        };

        $.ajax({
            url: '/EmployeeCTC/SaveEmployeeSalaryRevision',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),

            success: function (res) {

                if (res.Success) {
                    toastr.success(res.Message || "Saved successfully");

                    // 🔥 UPDATE GRID WITHOUT RELOAD
                    updateEmployeeRow(payload);

                    // 🔥 CLOSE MODAL
                    closeModal();
                } else {
                    toastr.error(res.Message || "Save failed");
                }
            },
            error: function () {
                toastr.error("Server error during save");
            }
        });
    }

    function updateEmployeeRow(payload) {

        let row = $(`#row_${payload.EmployeeID}`);

        if (!row.length) return;

        // Example columns (adjust as per your table)
        row.find('.col-gross').text(payload.MonthlyGross);
        row.find('.col-net').text(payload.NetPay);
        row.find('.col-ctc').text(payload.MonthlyCTC);

        // optional: highlight updated row
        row.addClass('updated-row');

        setTimeout(() => {
            row.removeClass('updated-row');
        }, 1500);
    }
