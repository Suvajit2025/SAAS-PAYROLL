<script>
    let allEmployees = [];   // 🔐 master copy (never mutate)
    let dt = null;
    let lastCalculatedData = null;
    let curConfig = [];
    let currentCalculationMode = 0;
    let isFirstEmployeeTableLoad = true;
    const currentTenantId = '@System.Web.HttpUtility.JavaScriptStringEncode(Convert.ToString(ViewBag.CurrentTenantID))';
    const netToGrossTenantId = '808E0AC6-94CE-4887-AD9D-85AF318ED335';
    function normalizeName(value) {
        return String(value || '')
            .trim()
            .toUpperCase()
            .replace(/\s+/g, '_');
    }

    function toBoolean(value) {
        return value === true ||
            value === 1 ||
            value === '1' ||
            String(value).toLowerCase() === 'true';
    }
    let salaryDetailState = {
        empId: 0,
        empSalaryConfigID: 0,
        empName: "",
        payGroupId: "",
        payGroupName: "",
        currentConfig: [],
        componentValuesById: {}
    };

    function parseMoney(value) {
        const parsed = parseFloat(value);
        return Number.isFinite(parsed) ? Math.round((parsed + Number.EPSILON) * 100) / 100 : 0;
    }

    function formatMoney(value) {
        return parseMoney(value).toFixed(2);
    }

    function roundMoney(value) {
        return Math.round(parseMoney(value));
    }

    function formatRoundedMoney(value) {
        return roundMoney(value).toFixed(2);
    }

    function formatRupee(value) {
        return Math.round(parseMoney(value)).toString();
    }

    function setMoneyText(selector, value) {
        $(selector).text(formatMoney(value));
    }

    function setCurrencyText(selector, value) {
        $(selector).text("₹ " + formatMoney(value));
    }

    function setRupeeCurrencyText(selector, value) {
        $(selector).text("₹ " + formatRupee(value));
    }

    $(document).ready(function () {

        // 1. Init Multiselects
        $('#ddlCompany, #ddlDepartment, #ddlCategory ,#ddlpaygroup').multiselect({

            includeSelectAllOption: true,
