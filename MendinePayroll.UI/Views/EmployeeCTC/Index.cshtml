        border-radius: 4px;
    }

    .modal-body {
        padding: 0;
        flex: 1;
        overflow-y: auto;
        background: #f8f9fa;
        display: flex;
        flex-direction: column;
    }

    /* Input Panel */
    .input-panel {
        background: white;
        padding: 15px 20px;
        border-bottom: 1px solid #ddd;
        display: flex;
        gap: 20px;
        align-items: flex-end;
    }

    .dynamic-input-group label {
        font-size: 12px;
