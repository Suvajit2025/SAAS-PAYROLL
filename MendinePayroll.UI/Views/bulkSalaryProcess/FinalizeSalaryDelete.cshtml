@{
    ViewBag.Title = "Delete Finalized Salary";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<style>
    #finalized-delete-page {
        font-family: 'Inter', sans-serif;
    }

    .fds-filter-panel {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 15px;
        margin-bottom: 15px;
    }

    .fds-summary {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 12px;
    }

    .fds-stat {
        min-width: 145px;
        padding: 9px 12px;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
    }

    .fds-stat span {
        display: block;
        font-size: 10px;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
    }

    .fds-stat strong {
        display: block;
        margin-top: 2px;
        font-size: 16px;
        color: #0f172a;
    }

    .fds-table-wrap {
        overflow: auto;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
    }

    .fds-table {
        width: 100%;
        margin-bottom: 0;
        border-collapse: collapse;
    }

    .fds-table th {
        padding: 10px 8px;
        background: #f1f5f9;
        border-bottom: 1px solid #cbd5e1;
        color: #475569;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .fds-table td {
        padding: 9px 8px;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
        font-size: 12px;
    }

    .fds-money {
        text-align: right;
        font-family: Consolas, monospace;
        font-weight: 600;
    }

    .fds-empty {
        padding: 28px 10px;
        text-align: center;
        color: #64748b;
        font-weight: 600;
    }

    .fds-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 8px;
        border-radius: 999px;
        background: #dcfce7;
        color: #166534;
        font-size: 11px;
        font-weight: 700;
    }

    .fds-badge-paid {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .fds-note {
        margin-top: 8px;
        color: #b91c1c;
        font-size: 12px;
        font-weight: 600;
    }

    .fds-selected-list {
        max-height: 260px;
        overflow: auto;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
    }

    .fds-selected-item {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 9px 11px;
        border-bottom: 1px solid #f1f5f9;
        font-size: 12px;
    }

    .fds-selected-item:last-child {
        border-bottom: 0;
    }

    .fds-selected-item strong {
        display: block;
        color: #0f172a;
    }

    .fds-selected-item small {
        color: #64748b;
    }

    .fds-confirm-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin-bottom: 14px;
    }

    .fds-confirm-summary .fds-stat {
        min-width: 0;
    }

    .fds-blocked-list {
        display: none;
        margin-bottom: 14px;
        border: 1px solid #fecaca;
        border-radius: 6px;
        background: #fef2f2;
        color: #991b1b;
        padding: 10px 12px;
        font-size: 12px;
    }

    .fds-blocked-list ul {
        margin: 6px 0 0 18px;
        padding: 0;
    }
</style>

<section role="main" class="content-body" id="finalized-delete-page">
    <header class="page-header">
        <h2 style="font-weight:700; margin:0;">Delete Finalized Salary</h2>
    </header>

    <section class="panel">
        <header class="panel-heading" style="display:flex; justify-content:space-between; align-items:center;">
            <div style="display:flex; align-items:center;">
                <button type="button" class="btn btn-default btn-sm" onclick="window.history.back();" style="margin-right:15px;">
                    <i class="fa fa-arrow-left text-muted"></i> Back
                </button>
                <h2 class="panel-title" style="margin:0; line-height:1;">
                    <i class="fa fa-trash text-danger mr-sm"></i> Finalized Employee Salary Delete
                </h2>
            </div>
            <div>
                <button type="button" class="btn btn-default btn-sm" onclick="loadFinalizedEmployees();">
                    <i class="fa fa-refresh"></i>
                </button>
                <button type="button" class="btn btn-danger btn-sm" id="btnDeleteSelected" onclick="deleteSelectedFinalizedSalary();" disabled>
                    <i class="fa fa-trash"></i> Delete Selected
                </button>
            </div>
        </header>

        <div class="panel-body">
            <div class="fds-filter-panel">
                <div class="row">
                    <div class="col-md-2">
                        <label class="control-label text-xs text-muted text-weight-bold">Month</label>
                        <select id="fltMonth" class="form-control input-sm"></select>
                    </div>
                    <div class="col-md-2">
                        <label class="control-label text-xs text-muted text-weight-bold">Year</label>
                        <select id="fltYear" class="form-control input-sm"></select>
                    </div>
                    <div class="col-md-3">
                        <label class="control-label text-xs text-muted text-weight-bold">Pay Group</label>
                        <select id="fltPayGroup" class="form-control input-sm">
                            <option value="">All Pay Groups</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="control-label text-xs text-muted text-weight-bold">Search</label>
                        <div class="input-group">
                            <span class="input-group-addon" style="background:#fff;"><i class="fa fa-search text-muted"></i></span>
                            <input type="text" id="txtSearch" class="form-control input-sm" placeholder="Employee name or code">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="control-label text-xs text-muted text-weight-bold">&nbsp;</label>
                        <button type="button" class="btn btn-primary btn-sm btn-block" onclick="loadFinalizedEmployees();">
                            <i class="fa fa-search"></i> Show
                        </button>
                    </div>
                </div>
                <div class="fds-note">
                    <i class="fa fa-warning"></i> Pay group is optional. Month and year will load all finalized employees when pay group is not selected.
                </div>
            </div>

            <div class="fds-summary">
                <div class="fds-stat">
                    <span>Finalized Employees</span>
                    <strong id="statRows">0</strong>
                </div>
                <div class="fds-stat">
                    <span>Selected</span>
                    <strong id="statSelected">0</strong>
                </div>
                <div class="fds-stat">
                    <span>Selected Net Pay</span>
                    <strong id="statNet">0.00</strong>
                </div>
            </div>

            <div class="fds-table-wrap">
                <table class="fds-table">
                    <thead>
                        <tr>
                            <th style="width:35px;" class="text-center"><input type="checkbox" id="chkAll"></th>
                            <th>Employee</th>
                            <th>Company</th>
                            <th>Pay Group</th>
                            <th class="text-right">Gross</th>
                            <th class="text-right">Deduction</th>
                            <th class="text-right">Net Pay</th>
                            <th class="text-center">Salary Status</th>
                            <th class="text-center">Pay Status</th>
                        </tr>
                    </thead>
                    <tbody id="employeeRows">
                        <tr><td colspan="9" class="fds-empty">Select month and year, then click Show.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</section>

<div class="modal fade" id="deleteConfirmModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger" style="padding:15px;">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true" style="color:white;">&times;</span>
                </button>
                <h4 class="modal-title" style="color:white; margin:0;">
                    <i class="fa fa-warning mr-xs"></i> Confirm Finalized Salary Delete
                </h4>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger" style="margin-bottom:14px;">
                    <strong>Review selected employees before delete.</strong>
                    Paid salary cannot be deleted. Enter a reason for unpaid finalized salary deletion.
                </div>

                <div class="fds-blocked-list" id="paidBlockedList"></div>

                <div class="fds-confirm-summary">
                    <div class="fds-stat">
                        <span>Period</span>
                        <strong id="confirmPeriod">--</strong>
                    </div>
                    <div class="fds-stat">
                        <span>Employees</span>
                        <strong id="confirmCount">0</strong>
                    </div>
                    <div class="fds-stat">
                        <span>Net Pay</span>
                        <strong id="confirmNet">0.00</strong>
                    </div>
                </div>

                <div class="fds-selected-list" id="confirmEmployeeList"></div>

                <div class="form-group" style="margin-top:14px;">
                    <label class="control-label text-xs text-muted text-weight-bold">Delete Reason <span class="text-danger">*</span></label>
                    <textarea id="txtDeleteReason" class="form-control" rows="3" maxlength="500" placeholder="Enter reason for deleting finalized salary"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="btnConfirmDelete" onclick="confirmDeleteFinalizedSalary();">
                    <i class="fa fa-trash"></i> Confirm Delete
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    var finalizedRows = [];
    var fdsConfirmCallbacks = {};

    $(document).ready(function () {
        initToastr();
        initMonthYear();
        loadPayGroups();

        $('#fltMonth, #fltYear, #fltPayGroup').on('change', loadFinalizedEmployees);
        $('#txtSearch').on('keyup', debounce(loadFinalizedEmployees, 350));
        $('#chkAll').on('change', function () {
            $('.fds-row-check').prop('checked', this.checked);
            updateSelectionSummary();
        });
    });

    function initToastr() {
        if (!window.toastr) return;

        toastr.options = {
            closeButton: true,
            progressBar: true,
            newestOnTop: true,
            positionClass: 'toast-top-right',
            preventDuplicates: true,
            timeOut: 3500,
            extendedTimeOut: 1500,
            escapeHtml: false
        };
    }

    function showToast(type, message, title) {
        if (window.toastr && toastr[type]) {
            toastr[type](message, title || '');
            return;
        }
        console.log((title ? title + ': ' : '') + message);
    }

    function showToastConfirm(message, onConfirm) {
        if (!window.toastr) {
            console.log(message);
            return;
        }

        var token = 'fds_' + Date.now() + '_' + Math.floor(Math.random() * 10000);
        fdsConfirmCallbacks[token] = onConfirm;

        toastr.warning(
            '<div style="margin-bottom:8px;">' + escapeHtml(message) + '</div>' +
            '<button type="button" class="btn btn-xs btn-danger js-fds-confirm" data-token="' + token + '">Confirm</button>' +
            '<button type="button" class="btn btn-xs btn-default js-fds-cancel" data-token="' + token + '" style="margin-left:6px;">Cancel</button>',
            'Confirm Delete',
            {
                timeOut: 0,
                extendedTimeOut: 0,
                tapToDismiss: false,
                closeButton: true
            }
        );
    }

    $(document).on('click', '.js-fds-confirm', function () {
        var token = $(this).data('token');
        var callback = fdsConfirmCallbacks[token];
        delete fdsConfirmCallbacks[token];
        if (window.toastr) toastr.clear($(this).closest('.toast'));
        if (callback) callback();
    });

    $(document).on('click', '.js-fds-cancel', function () {
        var token = $(this).data('token');
        delete fdsConfirmCallbacks[token];
        if (window.toastr) toastr.clear($(this).closest('.toast'));
        showToast('info', 'Delete cancelled.');
    });

    function initMonthYear() {
        var months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
        var now = new Date();
        var defaultMonth = now.getMonth();
        var defaultYear = now.getFullYear();

        if (defaultMonth === 0) {
            defaultMonth = 12;
            defaultYear = defaultYear - 1;
        }

        var monthHtml = '';
        for (var i = 0; i < months.length; i++) {
            monthHtml += '<option value="' + (i + 1) + '">' + months[i] + '</option>';
        }
        $('#fltMonth').html(monthHtml).val(defaultMonth);

        var yearHtml = '';
        for (var y = now.getFullYear() + 1; y >= now.getFullYear() - 3; y--) {
            yearHtml += '<option value="' + y + '">' + y + '</option>';
        }
        $('#fltYear').html(yearHtml).val(defaultYear);
    }

    function loadPayGroups() {
        $.getJSON('/bulkSalaryProcess/GetPayGroups', function (groups) {
            var html = '<option value="">All Pay Groups</option>';
            $.each(groups || [], function (_, p) {
                html += '<option value="' + escapeHtml(p.value) + '">' + escapeHtml(p.text) + '</option>';
            });
            $('#fltPayGroup').html(html);
        });
    }

    function loadFinalizedEmployees() {
        var month = parseInt($('#fltMonth').val(), 10);
        var year = parseInt($('#fltYear').val(), 10);
        if (!month || !year) return;

        $('#employeeRows').html('<tr><td colspan="9" class="fds-empty"><i class="fa fa-spinner fa-spin"></i> Loading finalized employees...</td></tr>');
        $('#chkAll').prop('checked', false);

        $.getJSON('/bulkSalaryProcess/GetFinalizedSalaryDeleteEmployees', {
            month: month,
            year: year,
            payGroupId: $('#fltPayGroup').val() || null,
            search: $('#txtSearch').val() || '',
            pageNumber: 1,
            pageSize: 1000
        }).done(function (res) {
            if (!res || !res.success) {
                finalizedRows = [];
                $('#employeeRows').html('<tr><td colspan="9" class="fds-empty text-danger">' + escapeHtml(res && res.message ? res.message : 'Unable to load employees.') + '</td></tr>');
                updateSelectionSummary();
                return;
            }
            finalizedRows = res.rows || [];
            renderRows(finalizedRows);
        }).fail(function () {
            finalizedRows = [];
            $('#employeeRows').html('<tr><td colspan="9" class="fds-empty text-danger">Server error while loading employees.</td></tr>');
            updateSelectionSummary();
        });
    }

    function renderRows(rows) {
        if (!rows.length) {
            $('#employeeRows').html('<tr><td colspan="9" class="fds-empty">No finalized salary found for the selected filters.</td></tr>');
            updateSelectionSummary();
            return;
        }

        var html = '';
        $.each(rows, function (_, r) {
            var paidText = Number(r.PaidStatus || 0) === 1
                ? '<span class="fds-badge fds-badge-paid"><i class="fa fa-check"></i> Paid</span>'
                : '<span class="text-muted">Unpaid</span>';

            html += '<tr>' +
                '<td class="text-center"><input type="checkbox" class="fds-row-check" value="' + r.PayrollProcessEmployeeID + '" data-net="' + Number(r.TotalTakeHome || 0) + '"></td>' +
                '<td><strong>' + escapeHtml(r.EmployeeName) + '</strong><br><small class="text-muted">' + escapeHtml(r.EmployeeCode) + '</small></td>' +
                '<td>' + escapeHtml(r.CompanyName) + '</td>' +
                '<td>' + escapeHtml(r.PayGroupName) + '</td>' +
                '<td class="fds-money">' + formatMoney(r.TotalGross) + '</td>' +
                '<td class="fds-money text-danger">' + formatMoney(r.TotalDeduction) + '</td>' +
                '<td class="fds-money text-primary">' + formatMoney(r.TotalTakeHome) + '</td>' +
                '<td class="text-center"><span class="fds-badge"><i class="fa fa-check-circle"></i> Finalized</span></td>' +
                '<td class="text-center">' + paidText + '</td>' +
                '</tr>';
        });

        $('#employeeRows').html(html);
        $('.fds-row-check').on('change', function () {
            var total = $('.fds-row-check').length;
            var selected = $('.fds-row-check:checked').length;
            $('#chkAll').prop('checked', total > 0 && total === selected);
            updateSelectionSummary();
        });
        updateSelectionSummary();
    }

    function updateSelectionSummary() {
        var selected = $('.fds-row-check:checked');
        var net = 0;
        selected.each(function () {
            net += Number($(this).data('net') || 0);
        });
        $('#statRows').text(finalizedRows.length);
        $('#statSelected').text(selected.length);
        $('#statNet').text(formatMoney(net));
        $('#btnDeleteSelected').prop('disabled', selected.length === 0);
    }

    function deleteSelectedFinalizedSalary() {
        var selectedRows = getSelectedRows();
        if (!selectedRows.length) {
            showToast('warning', 'Please select at least one employee.', 'Validation');
            return;
        }

        var paidRows = selectedRows.filter(function (row) {
            return Number(row.PaidStatus || 0) === 1;
        });
        var net = selectedRows.reduce(function (sum, row) {
            return sum + Number(row.TotalTakeHome || 0);
        }, 0);

        $('#confirmPeriod').text($('#fltMonth option:selected').text() + ' ' + $('#fltYear').val());
        $('#confirmCount').text(selectedRows.length);
        $('#confirmNet').text(formatMoney(net));
        $('#txtDeleteReason').val('');

        var html = '';
        $.each(selectedRows, function (_, r) {
            var paidBadge = Number(r.PaidStatus || 0) === 1
                ? ' <span class="text-danger text-weight-bold">(Paid - cannot delete)</span>'
                : '';
            html += '<div class="fds-selected-item">' +
                '<div><strong>' + escapeHtml(r.EmployeeName) + paidBadge + '</strong><small>' + escapeHtml(r.EmployeeCode) + ' | ' + escapeHtml(r.PayGroupName) + '</small></div>' +
                '<div class="fds-money">' + formatMoney(r.TotalTakeHome) + '</div>' +
                '</div>';
        });
        $('#confirmEmployeeList').html(html);

        if (paidRows.length) {
            var blockedHtml = '<strong>Delete blocked for paid salary:</strong><ul>';
            $.each(paidRows, function (_, r) {
                blockedHtml += '<li>' + escapeHtml(r.EmployeeName) + ' (' + escapeHtml(r.EmployeeCode) + ') - Salary is already marked as paid.</li>';
            });
            blockedHtml += '</ul>';
            $('#paidBlockedList').html(blockedHtml).show();
            $('#btnConfirmDelete').prop('disabled', true);
            $('#txtDeleteReason').prop('disabled', true);
        } else {
            $('#paidBlockedList').empty().hide();
            $('#btnConfirmDelete').prop('disabled', false);
            $('#txtDeleteReason').prop('disabled', false);
        }

        $('#deleteConfirmModal').modal('show');
    }

    function confirmDeleteFinalizedSalary() {
        var selectedRows = getSelectedRows();
        var reason = $.trim($('#txtDeleteReason').val());

        if (!selectedRows.length) {
            showToast('warning', 'Please select at least one employee.', 'Validation');
            return;
        }

        if (!reason) {
            showToast('warning', 'Please enter a reason before deleting finalized salary.', 'Validation');
            $('#txtDeleteReason').focus();
            return;
        }

        var paidRows = selectedRows.filter(function (row) {
            return Number(row.PaidStatus || 0) === 1;
        });
        if (paidRows.length) {
            showToast('error', 'Paid salary cannot be deleted. Please remove paid employees from the selection.', 'Delete Blocked');
            return;
        }

        showToastConfirm('Delete finalized salary for ' + selectedRows.length + ' unpaid employee(s)?', function () {
            submitFinalizedSalaryDelete(selectedRows, reason);
        });
    }

    function submitFinalizedSalaryDelete(selectedRows, reason) {
        $('#btnConfirmDelete').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Deleting...');

        $.ajax({
            url: '/bulkSalaryProcess/DeleteFinalizedSalaries',
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({
                Month: Number($('#fltMonth').val()),
                Year: Number($('#fltYear').val()),
                Reason: reason,
                PayrollProcessEmployeeIds: selectedRows.map(function (row) {
                    return Number(row.PayrollProcessEmployeeID);
                })
            })
        }).done(function (res) {
            if (res && res.success) {
                $('#deleteConfirmModal').modal('hide');
                showToast('success', res.message || 'Finalized salary deleted successfully.', 'Success');
                loadFinalizedEmployees();
                return;
            }

            var message = res && res.message ? res.message : 'Unable to delete finalized salary.';
            if (res && res.blockedEmployees && res.blockedEmployees.length) {
                message += '<br><br><strong>Blocked employees:</strong><br>' + res.blockedEmployees.map(function (e) {
                    return '- ' + escapeHtml(e.EmployeeName || '') + ' (' + escapeHtml(e.EmployeeCode || '') + '): ' + escapeHtml(e.Reason || '');
                }).join('<br>');
            }
            showToast('error', message, 'Delete Failed');
        }).fail(function () {
            showToast('error', 'Server error while deleting finalized salary.', 'Server Error');
        }).always(function () {
            $('#btnConfirmDelete').prop('disabled', false).html('<i class="fa fa-trash"></i> Confirm Delete');
        });
    }

    function getSelectedRows() {
        var selectedIds = $('.fds-row-check:checked').map(function () {
            return String(this.value);
        }).get();

        return finalizedRows.filter(function (row) {
            return selectedIds.indexOf(String(row.PayrollProcessEmployeeID)) >= 0;
        });
    }

    function formatMoney(value) {
        return Number(value || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function escapeHtml(value) {
        return $('<div/>').text(value == null ? '' : value).html();
    }

    function debounce(fn, wait) {
        var timer;
        return function () {
            clearTimeout(timer);
            timer = setTimeout(fn, wait);
        };
    }
</script>
