@model MendinePayroll.UI.Controllers.DashboardController.PayrollDashboardVM


@{
    ViewBag.Title = "Executive Payroll Command";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;300;400;500;600&display=swap');

    /* Main Layout - Vertical Scroll */
    .content-body {
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        color: #334155;
        background-color: #fcfdfe;
        height: 100vh;
        overflow-y: auto;
    }

    /* Horizontal Scroll for Dept Cards */
    .dept-scroll-container {
        display: flex;
        overflow-x: auto;
        gap: 12px;
        padding-bottom: 10px;
        scrollbar-width: thin;
    }

        .dept-scroll-container::-webkit-scrollbar {
            height: 4px;
        }

        .dept-scroll-container::-webkit-scrollbar-thumb {
            background: #e2e8f0;
            border-radius: 10px;
        }

    .card-flat {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 16px;
        height: 100%;
    }

    /* Bigger Headers */
    .page-header-text {
        font-size: 24px;
        font-weight: 300;
        color: #0f172a;
        letter-spacing: -0.025em;
    }

    .section-title {
        font-size: 14px;
        font-weight: 300;
        color: #1e293b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .label-caps {
        font-size: 10px;
        font-weight: 300;
        color: #94a3b8;
        text-transform: uppercase;
        margin-bottom: 4px;
        display: block;
    }

    .val-bold {
        font-size: 18px;
        font-weight: 300;
        color: #0f172a;
    }

    .chart-container {
        position: relative;
        height: 220px;
        width: 100%;
    }

    .filter-select {
        background-color: #f1f5f9;
        border: none;
        font-size: 11px;
        font-weight: 300;
        padding: 6px 12px;
        border-radius: 6px;
        outline: none;
    }
</style>
<script>
    let salaryChart;
    let componentChart;
    let companyDeptChart;

    function changeYear(year) {
        window.location.href = '@Url.Action("Index")?year=' + year;
    }

    $(document).ready(function () {

        // Call first time on page load
        loadSummary();

        // Call on EVERY dropdown change
        $(".filter-select").on("change", function () {
            loadSummary();
        });

    });
   

    function loadSummary() {
        /*alert('Test Change');*/
        var company = $("#CompanyId").val();
        var department = $("#DepartmentId").val();
        var year = $("#SelectedYear").val();
        var month = $("#SelectedMonth").val();

        $.ajax({
            url: '@Url.Action("GetPayrollSummary")',
            type: 'GET',
            data: {
                companyCode: company,
                departmentId: department,
                year: year,
                month: month
            },
            success: function (data) {

                
                //$("#totalCTC").text(formatCurrency(data.TotalCTC));
                //$("#netSalary").text(formatCurrency(data.NetSalary));
                //$("#employerContribution").text(formatCurrency(data.EmployerContribution));
                $("#totalCTC").text(formatCurrency(data.summary.TotalCTC));
                $("#netSalary").text(formatCurrency(data.summary.NetSalary));
                $("#employerContribution").text(formatCurrency(data.summary.EmployerContribution));
                $("#remainingLoanAmount").text(formatCurrency(data.summary.TotalRemainingLoan));

                //  Department wise
                renderDepartmentCards(data.deptList);


                renderSalaryTrend(data.trendList || []);
                renderComponentChart(data.componentList || []);
                renderCompanyDeptChart(data.companyDeptList || []);

                // Top Loans
                renderTopLoans(data.topLoanList || []);
                console.log(data.topLoanList);

            }
        });
    }

    function renderDepartmentCards(deptList) {

        var container = $("#deptContainer");
        container.empty(); // Clear old cards

        if (!deptList || deptList.length === 0) {
            container.append("<p class='text-gray-400'>No Data Available</p>");
            return;
        }

        deptList.forEach(function (dept) {

            var variance = dept.ActualCTC - dept.EstimatedCTC;

            var card = `
            <div class="min-w-[180px] card-flat bg-slate-50 border-none text-center">
                <p class="label-caps">${dept.DepartmentName}</p>
                <p class="text-xs text-gray-400">Estimated</p>
                <p class="val-bold text-sm">${formatCurrency(dept.EstimatedCTC)}</p>
                <p class="text-xs text-gray-400 mt-1">Actual</p>
                <p class="val-bold text-sm text-indigo-600">${formatCurrency(dept.ActualCTC)}</p>
                <p class="text-xs mt-1 ${variance >= 0 ? 'text-green-600' : 'text-red-600'}">
                    Variance: ${formatCurrency(variance)}
                </p>
            </div>
        `;

            container.append(card);
        });
    }


    function formatCurrency(value) {
        if (!value) return "₹ 0";
        return "₹ " + parseFloat(value).toLocaleString('en-IN');
    }

    
</script>
<section role="main" class="content-body p-6">
    <header class="page-header"><h2>Payroll Dashboard</h2></header>
    <div class="max-w-[1400px] mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4 border-b border-slate-100 pb-6">
            <div>
                <h1 class="text-lg font-bold text-slate-900 uppercase tracking-tight">Payroll Control</h1>
                <p class="text-[10px] text-slate-400">Company Internal Assets & Liabilities Dashboard • FY 2025-26</p>
            </div>

            <div class="flex flex-wrap gap-3 items-center bg-white p-3 rounded-xl shadow-sm border border-slate-100">
                @Html.DropDownList(
                        "CompanyId",
                        Model.CompanyList,
                        new { @class = "filter-select" }
                    )
                @Html.DropDownList(
                        "DepartmentId",
                        Model.DepartmentList,
                        new { @class = "filter-select" }
                    )
                @Html.DropDownListFor(
                    m => m.SelectedYear,
                    Model.YearList,
                    new { @class = "filter-select"}
                )
               @Html.DropDownListFor(
                    m => m.SelectedMonth,
                    Model.MonthList,
                    new { @class = "filter-select" }
               )
            @*<button class="bg-indigo-400 text-white px-5 py-2 rounded-lg font-bold text-[11px] hover:bg-indigo-500 transition-all">REFRESH AUDIT</button>*@
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4 mb-8">
            <div class="card-flat border-t-4 border-indigo-500">
                <span class="label-caps">Total CTC</span>
                <span class="val-bold" id="totalCTC">₹0</span>
            </div>
            <div class="card-flat border-t-4 border-emerald-500">
                <span class="label-caps">Net Salary Recovery</span>
                <span class="val-bold text-emerald-600" id="netSalary">₹0</span>
            </div>

            <div class="card-flat border-t-4 border-amber-500">
                <span class="label-caps">Employer Contribution</span>
                <span class="val-bold text-amber-600" id="employerContribution">₹0</span>
            </div>
            <div class="card-flat border-t-4 border-blue-500">
                <span class="label-caps">Employee TDS</span>
                <span class="val-bold text-blue-600">₹0.00</span>
            </div>
            <div class="card-flat border-t-4 border-rose-500">
                <span class="label-caps">Remaining Loan Amount</span>
                <span class="val-bold text-rose-600" id="remainingLoanAmount">₹0</span>
            </div>
        </div>

        <div class="mb-8" id="">
            <h3 class="section-title mb-4">Department Spend Breakdown (Horizontal Scroll)</h3>
            <div class="dept-scroll-container" id="deptContainer">
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
            <div class="card-flat">
                <h3 class="section-title mb-6">Last 3 Months Salary Trends</h3>
                <div class="chart-container"><canvas id="salaryTrendChart"></canvas></div>
            </div>

            <div class="card-flat">
                <h3 class="section-title mb-6">Component Comparison (Net vs Stat vs Contrib)</h3>
                <div class="chart-container"><canvas id="componentCompareChart"></canvas></div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
            <div class="card-flat lg:col-span-2">
                <h3 class="section-title mb-6">Company-wise Department Spend</h3>
                <div class="chart-container"><canvas id="companyDeptChart"></canvas></div>
            </div>

            <div class="card-flat">
                <h3 class="section-title mb-6">Top Loan Deductions</h3>
                <table class="w-full text-left">
                    <thead>
                        <tr class="text-[10px] text-slate-400 uppercase border-b pb-2">
                            <th class="py-2">Employee</th>

                            <th>Total Loan Amount</th>
                            <th>EMI Recovery</th>
                        </tr>
                    </thead>
                    <tbody class="text-[11px] font-medium" id="topLoanBody">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<script>


    /*Chart Js start*/

    function renderSalaryTrend(data) {

        if (salaryChart) {
            salaryChart.destroy();
        }

        if (!data || data.length === 0) {
            return;
        }

        salaryChart = new Chart(document.getElementById('salaryTrendChart'), {
            type: 'line',
            data: {
                labels: data.map(x => x.MonthName),
                datasets: [
                    {
                        label: 'Total Gross',
                        data: data.map(x => x.TotalGross),
                        borderColor: '#6366f1',
                        backgroundColor: 'transparent',
                        tension: 0.3
                    },
                    {
                        label: 'Total Net',
                        data: data.map(x => x.TotalNet),
                        borderColor: '#10b981',
                        backgroundColor: 'transparent',
                        tension: 0.3
                    }
                ]
            },
            options: commonOptions
        });
    }

    function renderComponentChart(data) {

        if (componentChart) {
            componentChart.destroy();
        }

        if (!data || data.length === 0) {
            return;
        }

        componentChart = new Chart(document.getElementById('componentCompareChart'), {
            type: 'bar',
            data: {
                labels: data.map(x => x.MonthName),
                datasets: [
                    {
                        label: 'Net Payable',
                        data: data.map(x => x.NetPayable),
                        backgroundColor: '#10b981'
                    },
                    {
                        label: 'Statutory',
                        data: data.map(x => x.Statutory),
                        backgroundColor: '#f59e0b'
                    },
                    {
                        label: 'Employer Contribution',
                        data: data.map(x => x.EmployerContribution),
                        backgroundColor: '#4f46e5'
                    }
                ]
            },
            options: commonOptions
        });
    }
    function renderCompanyDeptChart(data) {

        if (companyDeptChart) {
            companyDeptChart.destroy();
        }

        if (!data || data.length === 0) {
            return;
        }

        companyDeptChart = new Chart(document.getElementById('companyDeptChart'), {
            type: 'bar',
            data: {
                labels: data.map(x => x.CompanyName),
                datasets: [
                    {
                        label: 'Total Spend',
                        data: data.map(x => x.TotalSpend),
                        backgroundColor: '#4f46e5'
                    }
                ]
            },
            options: commonOptions
        });
    }

    function renderTopLoans(data) {

        let body = $("#topLoanBody");
        body.empty();

        if (!data || data.length === 0) {
            body.append("<tr><td colspan='2'>No Data</td></tr>");
            return;
        }

        data.forEach(function (x) {

            body.append(`
            <tr>
                <td class="py-3 border-b border-slate-50">
                    ${x.EmployeeName}
                </td>
                
                 <td class="py-3 border-b border-slate-50 font-bold text-indigo-600">
                     ${formatCurrency(x.LoanAmount)}
                 </td>
                 <td class="py-3 border-b border-slate-50 font-bold text-indigo-600">
                    ${formatCurrency(x.EMIAmount)}
                </td>
            </tr>
        `);

        });
    }
    /*Chart Js End*/
    const commonOptions = {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {
                display: true,
                position: 'bottom'
            }
        },
        scales: {
            x: {
                grid: { display: false }
            },
            y: {
                beginAtZero: true
            }
        }
    };

