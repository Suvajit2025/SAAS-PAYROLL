<script>
    const INR = n => '₹' + Number(n).toLocaleString('en-IN');
    const fmt2 = n => parseFloat(n).toFixed(2);
    const todayStr = () => {
        const d = new Date();
        return d.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
    };

    let configs = [];

    let slabs = [];

    let editingId = null;
    let nextConfigId = 1;
    let nextSlabId = 1;
    let modalFinancialYears = [];

    function normalizeFinancialYear(text) {
        return (text || '').replace(/\s*\(Current\)\s*/i, '').trim();
    }

    function loadModalFinancialYears(selectedFy) {
        return $.get('/PayrollTds/GetFinancialYears')
            .done(function (financialYears) {
                modalFinancialYears = financialYears || [];

                let options = ['<option value="">Select FY</option>'];

                modalFinancialYears.forEach(function (fy) {
                    let fyCode = normalizeFinancialYear(fy.text);
                    options.push(`<option value="${fyCode}">${fyCode}</option>`);
                });

                $('#mFY').html(options.join(''));

                if (selectedFy) {
                    $('#mFY').val(selectedFy);
                } else {
                    let currentFy = modalFinancialYears.find(function (fy) {
                        return fy.isCurrent;
                    });

                    if (currentFy) {
                        $('#mFY').val(normalizeFinancialYear(currentFy.text));
                    }
                }
            })
            .fail(function () {
                $('#mFY').html('<option value="">Unable to load FY</option>');
                toastr.error('Failed to load financial years for the modal.');
            });
    }

    function renderConfigs() {
        let $tbody = $('#configTbody');

        $tbody.html('<tr><td colspan="8"><div class="empty-state">Loading configurations...</div></td></tr>');

        $.get('/PayrollTds/GetTdsConfigurationRows')
            .done(function (res) {
                if (res && res.success === false) {
                    $tbody.html('<tr><td colspan="8"><div class="empty-state">Unable to load configurations.</div></td></tr>');
                    toastr.error(res.message || 'Failed to load tax configuration data.');
                    return;
                }

                configs = (res || []).map(function (r, index) {
                    let normalizedActive = String(r.active || '1').toLowerCase();

                    return {
                        id: r.id || String(index + 1),
                        fy: normalizeFinancialYear(r.fy),
                        regimeId: String(r.regimeId || ''),
                        regime: r.regime || '',
                        cess: r.cess || 0,
                        rebate: r.rebate || 0,
                        threshold: r.threshold || 0,
                        std: r.std || 0,
                        active: (normalizedActive === 'true' || normalizedActive === '1') ? '1' : '0',
                        created: todayStr()
                    };
                });

                nextConfigId = configs.length + 1;
                updateConfigTable();
            })
            .fail(function () {
                $tbody.html('<tr><td colspan="8"><div class="empty-state">Unable to load configurations.</div></td></tr>');
                toastr.error('Failed to load tax configuration data.');
            });
    }

    function loadSlabsForEdit(fy, regimeId, regimeName) {
        return $.get('/PayrollTds/GetTaxSlabAndConstant', {
            financialYear: fy,
            regimeId: regimeId
        })
            .done(function (res) {
                let modalRows = (res && res.slabs) || [];

                slabs = modalRows.map(function (slab, index) {
                    return {
                        id: nextSlabId + index,
                        fy: fy,
                        regime: regimeName,
                        from: slab.from || 0,
                        to: slab.to == null ? 99999999 : slab.to,
                        rate: slab.rate || 0,
                        desc: slab.description || slab.desc || '',
                        active: '1',
                        created: todayStr()
                    };
                });

                if (res && res.constant) {
                    $('#mStd').val(res.constant.standardDeduction || 0);
                    $('#mRebate').val(res.constant.rebateLimit || 0);
                    $('#mThreshold').val(res.constant.rebateThreshold || 0);
                    $('#mCess').val(res.constant.cessRate || 0);
                }

                nextSlabId += modalRows.length;
            })
            .fail(function () {
                slabs = [];
                toastr.error('Failed to load slab details for edit.');
            });
    }

    function setModalMode(isEdit) {
        if (isEdit) {
            $('#modalHeading').text('Edit Tax Configuration');
            $('#modalSubheading').text('Update FY & regime tax setup with slabs');
            $('#modalFootNote').text('Review the values and save your changes');
            $('#modalHeaderIcon').removeClass('add-icon').addClass('edit-icon');
            $('#modalHeaderSvg').html('<path d="M12 20h9M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"></path>');
            $('#modalSaveBtn').html(`
                <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z" /><polyline points="17 21 17 13 7 13 7 21" /><polyline points="7 3 7 8 15 8" /></svg>
                Update Configuration
            `);
        } else {
            $('#modalHeading').text('Add Tax Configuration');
            $('#modalSubheading').text('Create a new FY & regime tax setup with slabs');
            $('#modalFootNote').text('All fields marked * are required');
            $('#modalHeaderIcon').removeClass('edit-icon').addClass('add-icon');
            $('#modalHeaderSvg').html('<line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>');
            $('#modalSaveBtn').html(`
                <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z" /><polyline points="17 21 17 13 7 13 7 21" /><polyline points="7 3 7 8 15 8" /></svg>
                Save Configuration
            `);
        }
    }

    function updateConfigTable() {
        let $tbody = $('#configTbody');

        if (!configs.length) {
            $tbody.html('<tr><td colspan="8"><div class="empty-state">No configurations found.</div></td></tr>');
        } else {
            let html = configs.map(r => `
        <tr>
            <td>${r.fy}</td>
            <td>${r.regime}</td>
            <td>${fmt2(r.cess)}%</td>
            <td>${INR(r.rebate)}</td>
            <td>${INR(r.threshold)}</td>
            <td>${INR(r.std)}</td>
            <td>${r.active === '1' ? 'Active' : 'Inactive'}</td>
           <td>
            <div class="action-cell">
                <button class="btn btn-ghost-edit editBtn" data-id="${r.id}">
                    <svg viewBox="0 0 24 24">
                        <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                        <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                    </svg>
                    Edit
                </button>

            </div>
        </td>
        </tr>`).join('');

            $tbody.html(html);
        }

        updateStats();
    }

    //<button class="btn btn-ghost-del deleteBtn" data-id="${r.id}">
    //    <svg viewBox="0 0 24 24">
    //        <polyline points="3 6 5 6 21 6"/>
    //        <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
    //        <path d="M10 11v6M14 11v6"/>
    //        <path d="M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2"/>
    //    </svg>
    //    Delete
    //</button>
    function renderSlabs() {
        let html = slabs.map(s => `
        <tr>
            <td>${s.fy}</td>
            <td>${s.regime}</td>
            <td>${INR(s.from)}</td>
            <td>${Number(s.to) >= 99999999 ? '—' : INR(s.to)}</td>
            <td>${fmt2(s.rate)}%</td>
            <td>${s.desc}</td>
            <td>${s.active === '1' ? 'Active' : 'Inactive'}</td>
        </tr>
    `).join('');

        $('#slabTbody').html(html);
    }

    function updateStats() {
        $('#statTotal').text(configs.length);
        $('#statActive').text(configs.filter(c => c.active === '1').length);
        $('#statFYs').text(new Set(configs.map(c => c.fy)).size);
        $('#statRegimes').text(new Set(configs.map(c => c.regimeId)).size);
    }

    function addSlabRow(from = '', to = '', rate = '', desc = '') {
        let idx = $('#modalSlabRows tr').length + 1;

        let row = `
    <tr>
        <td>${idx}</td>
        <td><input type="number" value="${from}"></td>
        <td><input type="number" value="${to}"></td>
        <td><input type="number" value="${rate}"></td>
        <td><input type="text" value="${desc}"></td>
        <td>
            <button type="button" class="removeRow del-btn" title="Remove slab row" aria-label="Remove slab row">
                <svg viewBox="0 0 24 24">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"></path>
                    <path d="M10 11v6M14 11v6"></path>
                    <path d="M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2"></path>
                </svg>
            </button>
        </td>
    </tr>`;

        $('#modalSlabRows').append(row);
    }

    function clearModal() {
        $('#mConstantId, #mFY, #mRegime, #mStd, #mRebate, #mThreshold, #mCess').val('');
        $('#mActive').val('1');
        $('#modalSlabRows').html('');
        $('#modalFootNote').text('All fields marked * are required');
        clearValidationState();
    }

    function clearValidationState() {
        $('#configModal .input-error').removeClass('input-error');
        $('#configModal .label-error').removeClass('label-error');
    }

    function markInvalid(selector) {
        $(selector).addClass('input-error');
        $(selector).closest('.fld').find('label').addClass('label-error');
    }

    function validateConfigForm() {
        clearValidationState();

        let errors = [];
        let fy = $('#mFY').val();
        let regimeId = $('#mRegime').val();
        let std = $('#mStd').val();
        let rebate = $('#mRebate').val();
        let threshold = $('#mThreshold').val();
        let cess = $('#mCess').val();
        let slabRows = $('#modalSlabRows tr');

        if (!fy) {
            markInvalid('#mFY');
            errors.push('Financial Year is required.');
        }

        if (!regimeId) {
            markInvalid('#mRegime');
            errors.push('Tax Regime is required.');
        }

        if (!std || Number(std) < 0) {
            markInvalid('#mStd');
            errors.push('Standard Deduction must be 0 or greater.');
        }

        if (!rebate || Number(rebate) < 0) {
            markInvalid('#mRebate');
            errors.push('Rebate Limit 87A must be 0 or greater.');
        }

        if (threshold && Number(threshold) < 0) {
            markInvalid('#mThreshold');
            errors.push('Rebate Income Threshold cannot be negative.');
        }

        if (cess && Number(cess) < 0) {
            markInvalid('#mCess');
            errors.push('Health & Edu Cess cannot be negative.');
        }

        if (!slabRows.length) {
            errors.push('At least one slab row is required.');
        }

        slabRows.each(function (index) {
            let inputs = $(this).find('input');
            let fromInput = inputs.eq(0);
            let toInput = inputs.eq(1);
            let rateInput = inputs.eq(2);

            let fromVal = fromInput.val();
            let toVal = toInput.val();
            let rateVal = rateInput.val();

            if (fromVal === '' || Number(fromVal) < 0) {
                fromInput.addClass('input-error');
                errors.push(`Slab row ${index + 1}: From Amount must be 0 or greater.`);
            }

            if (toVal !== '' && Number(toVal) < Number(fromVal || 0)) {
                toInput.addClass('input-error');
                errors.push(`Slab row ${index + 1}: To Amount must be greater than or equal to From Amount.`);
            }

            if (rateVal === '' || Number(rateVal) < 0) {
                rateInput.addClass('input-error');
                errors.push(`Slab row ${index + 1}: Rate must be 0 or greater.`);
            }
        });

        if (errors.length) {
            $('#modalFootNote').text(errors[0]);
            toastr.error(errors[0]);
            return false;
        }

        $('#modalFootNote').text('All fields marked * are required');
        return true;
    }

    function openAddModal() {
        editingId = null;
        clearModal();
        setModalMode(false);
        $.when(loadModalFinancialYears())
            .always(function () {
                addSlabRow();
                $('#configModal').css('display', 'flex').addClass('open');
            });
    }

    function openEditModal(id) {
        editingId = id;
        clearModal();
        setModalMode(true);

        $.get('/PayrollTds/GetTdsConfigurationById', { id: id })
            .done(function (res) {
                if (!res || res.success === false || !res.data) {
                    toastr.error((res && res.message) || 'Failed to load configuration details.');
                    return;
                }

                let r = {
                    id: res.data.id || id,
                    fy: normalizeFinancialYear(res.data.fy),
                    regimeId: String(res.data.regimeId || ''),
                    regime: res.data.regime || '',
                    cess: res.data.cess || 0,
                    rebate: res.data.rebate || 0,
                    threshold: res.data.threshold || 0,
                    std: res.data.std || 0,
                    active: String(res.data.active || '1')
                };

                $('#mConstantId').val(r.id);
                $('#mActive').val((r.active === 'true' || r.active === '1') ? '1' : '0');

                $.when(loadModalFinancialYears(r.fy))
                    .always(function () {
                        $('#mFY').val(r.fy);
                        $('#mRegime').val(r.regimeId);

                        $.when(loadSlabsForEdit(r.fy, r.regimeId, r.regime))
                            .always(function () {
                                let matchSlabs = slabs.filter(s => s.fy === r.fy && s.regime === r.regime);

                                if (matchSlabs.length) {
                                    matchSlabs.forEach(s => addSlabRow(s.from, s.to, s.rate, s.desc));
                                } else {
                                    addSlabRow();
                                }

                                $('#configModal').css('display', 'flex').addClass('open');
                            });
                    });
            })
            .fail(function () {
                toastr.error('Failed to load configuration details.');
            });
    }

    function closeModal() {
        $('#configModal').removeClass('open').css('display', 'none');
        editingId = null;
    }

    function saveConfig() {
        if (!validateConfigForm()) {
            return;
        }

        let fy = $('#mFY').val();
        let regimeId = $('#mRegime').val();
        let std = $('#mStd').val();
        let rebate = $('#mRebate').val();
        let threshold = $('#mThreshold').val() || '0';
        let cess = $('#mCess').val() || '4.00';

        let payloadSlabs = [];
        $('#modalSlabRows tr').each(function () {
            let inputs = $(this).find('input');
            payloadSlabs.push({
                FromAmount: inputs.eq(0).val() || '0',
                ToAmount: inputs.eq(1).val() || null,
                TaxRate: inputs.eq(2).val() || '0',
                Description: inputs.eq(3).val() || ''
            });
        });

        $.ajax({
            url: '/PayrollTds/SaveFullTaxConfiguration',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                FinancialYear: fy,
                RegimeId: regimeId,
                StandardDeduction: std,
                RebateLimit87A: rebate,
                RebateIncomeThreshold: threshold,
                HealthEduCessRate: cess,
                Slabs: payloadSlabs
            }),
            beforeSend: function () {
                $('#modalSaveBtn').prop('disabled', true).text('Saving...');
            },
            success: function (res) {
                if (res && res.success) {
                    closeModal();
                    renderConfigs();
                    toastr.success(res.message || 'Configuration saved successfully.');
                } else {
                    toastr.error((res && res.message) || 'Failed to save configuration.');
                }
            },
            error: function () {
                toastr.error('Server communication error.');
            },
            complete: function () {
                $('#modalSaveBtn').prop('disabled', false);
                setModalMode(!!editingId);
            }
        });
    }

    /* ================= EVENTS ================= */

    $(document).on('click', '.editBtn', function () {
        openEditModal($(this).data('id'));
    });

    $(document).on('click', '.deleteBtn', function () {
        toastr.info('Delete API is not wired yet.');
    });

    $(document).on('click', '.removeRow', function () {
        $(this).closest('tr').remove();
    });

    $('#saveBtn').click(saveConfig);

    $('#configModal').click(function (e) {
        if (e.target === this) closeModal();
    });

    $(document).keydown(function (e) {
        if (e.key === "Escape") closeModal();
    });

    /* INIT */
    loadModalFinancialYears();
    renderConfigs();
    renderSlabs();
</script>
