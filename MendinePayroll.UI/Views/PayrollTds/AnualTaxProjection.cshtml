@section scripts {
  <script>
        // ================= PAGINATION STATE =================
        let currentPage = 1;
        let pageSize = 10;
        let allRows = [];
        let filteredRows = [];

        // ================= INITIALIZE PAGINATION =================
        function setupPagination() {

            allRows = $('#tbodyData tr[data-empid]').toArray();
            filteredRows = [...allRows];

            currentPage = 1;
            renderTable();
        }

        // ================= RENDER TABLE =================
        function renderTable() {

            const totalRows = filteredRows.length;
            const totalPages = Math.ceil(totalRows / pageSize);

            // Hide all rows first
            $('#tbodyData tr[data-empid]').hide();

            if (totalRows === 0) {
                $('#paginationContainer').html('');
                return;
            }

            const start = (currentPage - 1) * pageSize;
            const end = start + pageSize;

            filteredRows.slice(start, end).forEach(row => {
                $(row).show();
            });
            // 🔹 Record count text
            $('#recordInfo').text(
                `Showing ${start + 1}-${Math.min(end, totalRows)} of ${totalRows} rows`
            );

            renderPaginationControls(totalPages);
        }

        // ================= PAGINATION BUTTONS =================
        function renderPaginationControls(totalPages) {

            let html = '';

            if (totalPages <= 1) {
                $('#paginationContainer').html('');
                return;
            }

            const maxVisible = 5; // how many buttons to show
            let startPage = Math.max(1, currentPage - 2);
            let endPage = Math.min(totalPages, startPage + maxVisible - 1);

            // Adjust start if near end
            if (endPage - startPage < maxVisible - 1) {
                startPage = Math.max(1, endPage - maxVisible + 1);
            }

            // Prev button
            html += `<button class="btn btn-sm btn-light" onclick="changePage(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''}>Prev</button> `;

            // First page + dots
            if (startPage > 1) {
                html += `<button class="btn btn-sm btn-light" onclick="changePage(1)">1</button> `;
                if (startPage > 2) {
                    html += `<span class="btn btn-sm btn-light disabled">...</span> `;
                }
            }

            // Visible page range
            for (let i = startPage; i <= endPage; i++) {
                html += `<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'}"
                    onclick="changePage(${i})">${i}</button> `;
            }

            // Last page + dots
            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    html += `<span class="btn btn-sm btn-light disabled">...</span> `;
                }
                html += `<button class="btn btn-sm btn-light" onclick="changePage(${totalPages})">${totalPages}</button> `;
            }

            // Next button
            html += `<button class="btn btn-sm btn-light" onclick="changePage(${currentPage + 1})"
                ${currentPage === totalPages ? 'disabled' : ''}>Next</button>`;

            $('#paginationContainer').html(html);
        }

        // ================= PAGE CHANGE =================
        function changePage(page) {

            const totalPages = Math.ceil(filteredRows.length / pageSize);

            if (page < 1 || page > totalPages) return;

            currentPage = page;
            renderTable();
        }

        // ================= SEARCH =================
        $('#txtSearch').on('keyup', function () {

            const keyword = $(this).val().toLowerCase().trim();

            if (keyword === '') {
                filteredRows = [...allRows];
            } else {
                filteredRows = allRows.filter(row =>
                    $(row).text().toLowerCase().includes(keyword)
                );
            }

            currentPage = 1;
            renderTable();
        });

        // ================= PAGE SIZE CHANGE =================
        $('#ddlPageSize').on('change', function () {

            pageSize = parseInt($(this).val());
            currentPage = 1;
            renderTable();
        });
    </script>
  <script>
    // ---------- State ----------
    let currentEmpId = 0;
    const savedProjectionSummary = {};
    let pendingEditYear = null;
    let projectionRequestToken = 0;
    let rebateRefreshToken = 0;
    let activeProjectionRequest = null;
    let activeRebateRequests = [];

    function openProjectionEditor(finYearId, regimeId, loadSavedData, financialYearCode) {
        pendingEditYear = financialYearCode || finYearId || null;

        if (!pendingEditYear && !loadSavedData) {
            resetProjectionEditor();
        }

        $('#projectionEditorModal').addClass('open').hide().fadeIn(150);
        $('#ddlFY').data('financial-year-id', finYearId || '').data('financial-year-code', financialYearCode || '');

        if (pendingEditYear) {
            loadFY(function () {
                selectFinancialYear(finYearId, financialYearCode || pendingEditYear);

                if (regimeId) {
                    if ($('#ddlRegime option[value="' + regimeId + '"]').length === 0) {
                        $('#ddlRegime').append(`<option value="${regimeId}">Regime ${regimeId}</option>`);
                    }
                    $('#ddlRegime').val(regimeId);
                }
                if (loadSavedData) {
                    loadSavedProjectionDetails(financialYearCode || pendingEditYear, regimeId || $('#ddlRegime').val());
                }
            });
            return;
        }

        loadFY(function () {
            selectCurrentFinancialYear();
        });
    }

    function resetProjectionEditor() {
        pendingEditYear = null;
        currentPage = 1;
        allRows = [];
        filteredRows = [];

        $('#ddlFY').val('').removeData('financial-year-id').removeData('financial-year-code');
        $('#ddlRegime').val('2');
        $('#chkRebate').prop('checked', false).prop('disabled', false);
        $('#isRebateApplied').val(0);
        $('#rebateText').text('Not Applied');
        $('#txtSearch').val('');
        $('#recordInfo').text('');
        $('#paginationContainer').html('');
        $('#tbodyData').html('<tr><td colspan="9" class="text-center">Select filters and click Generate to create projection.</td></tr>');
        $('#btnFinalize').prop('disabled', false).html('<i class="fa fa-save"></i> Finalize & Save');
        $('#projectionEditorModal').find('.projection-finalized-message').remove();

        resetMultiselect('#ddlCompany');
        resetMultiselect('#ddlDepartment');
        resetMultiselect('#ddlEmployee', true);
    }

    function resetMultiselect(selector, clearOptions) {
        const $ddl = $(selector);
        if (clearOptions) {
            $ddl.empty();
        }
        $ddl.val([]);
        const multiselect = $ddl.data('multiselect');
        if (multiselect && typeof multiselect === 'object') {
            if (typeof multiselect.deselectAll === 'function') {
                multiselect.deselectAll(false);
            }
            if (typeof multiselect.rebuild === 'function') {
                multiselect.rebuild();
            }
            if (typeof multiselect.enable === 'function') {
                multiselect.enable();
            }
        }
    }

    function closeProjectionEditor() {
        $('#projectionEditorModal').fadeOut(120, function () {
            $(this).removeClass('open');
        });
    }

    function loadSavedProjectionDetails(financialYear, regimeId) {
        if (!financialYear || !regimeId) return;

        $('#tbodyData').html('<tr><td colspan="9" class="text-center"><i class="fa fa-spinner fa-spin"></i> Loading saved projection...</td></tr>');
        $('#recordInfo').text('');
        $('#paginationContainer').html('');

        $.getJSON('@Url.Action("GetAnnualTdsProjectionDetails", "PayrollTds")',
            { FinancialYear: financialYear, RegimeId: regimeId },
            function (res) {
                if (!res || !res.success) {
                    $('#tbodyData').html(`<tr><td colspan="9" class="text-center text-danger">${(res && res.message) ? res.message : 'Unable to load saved projection.'}</td></tr>`);
                    return;
                }

                renderProjectionRows(res.Data || []);
            }
        ).fail(function () {
            $('#tbodyData').html('<tr><td colspan="9" class="text-center text-danger">Error loading saved projection.</td></tr>');
        });
    }

    function renderProjectionRows(rows) {
        let html = '';

        if (!rows || rows.length === 0) {
            html = '<tr><td colspan="9" class="text-center">No projection rows found.</td></tr>';
        } else {
            rows.forEach(function (row, index) {
                html += `<tr data-empid="${row.EmployeeID}">
                    <td class="text-center">${index + 1}</td>
                    <td>${row.EmployeeName || row.EmployeeID}</td>
                    <td class="text-right annualgross">${row.AnnualGross}</td>
                    <td class="text-right nettaxable">${row.NetTaxable}</td>
                    <td class="text-right totalBaseTax">${row.TotalTaxBeforeCess}</td>
                    <td class="text-right cessAmount">${row.CessAmount}</td>
                    <td class="text-right annualTax">${row.AnnualTax}</td>
                    <td class="text-right monthlyTds bold-blue">${row.MonthlyTDS}</td>
                    <input type="hidden" class="rebateApplied" value="${row.RebateApplied || 0}" />
                    <td class="text-center">
                        <button class="btn btn-sm btn-outline-primary" onclick="viewDetails('${row.EmployeeID}')">
                            <i class="fa fa-list-alt"></i>
                        </button>
                    </td>
                </tr>`;
            });
        }

        $('#tbodyData').html(html);
        setupPagination();
    }

    function getSelectedFinancialYearId() {
        return $('#ddlFY').val() || $('#ddlFY').data('financial-year-id');
    }

    function updateProjectionRowFromSummary(empId, summary) {
        const $row = $('#tbodyData tr[data-empid="' + empId + '"]');
        if (!$row.length || !summary) return;

        const rebateFlag = summary.RebateApplied ? 1 : 0;
        const annualTax = summary.TotalTaxPayable
            || summary.AnnualTaxLiability
            || summary.AnnualTax
            || formatNumber(cleanNumber(summary.TotalTaxBeforeCess) + cleanNumber(summary.CessAmount));

        $row.find('.annualgross').text(summary.AnnualGross || '0.00');
        $row.find('.nettaxable').text(summary.NetTaxable || '0.00');
        $row.find('.totalBaseTax').text(summary.TotalTaxBeforeCess || '0.00');
        $row.find('.cessAmount').text(summary.CessAmount || '0.00');
        $row.find('.annualTax').text(annualTax || '0.00');
        $row.find('.monthlyTds').text(summary.MonthlyTDS || '0.00');
        $row.find('.rebateApplied').val(rebateFlag);

        if (rebateFlag === 1) {
            $row.addClass('table-success');
        } else {
            $row.removeClass('table-success');
        }
    }

    function refreshProjectionGridForRebate(isRebateApplied) {
        const activeToken = ++rebateRefreshToken;
        const year = getSelectedFinancialYearId();
        const rows = $('#tbodyData tr[data-empid]').toArray();

        if (!year || rows.length === 0) return;

        const previousInfo = $('#recordInfo').text();
        $('#recordInfo').html('<i class="fa fa-spinner fa-spin"></i> Updating rebate calculation...');
        $('#chkRebate').prop('disabled', true);

        let completed = 0;
        let failed = false;

        rows.forEach(function (row) {
            const empId = $(row).data('empid');

            const request = $.post("@Url.Action("GetTdsAudit", "PayrollTds")",
                { empId: empId, year: year, isRebateApplied: isRebateApplied },
                function (res) {
                    if (activeToken !== rebateRefreshToken) return;

                    if (!res || !res.success) {
                        failed = true;
                        return;
                    }

                    updateProjectionRowFromSummary(empId, res.Summary);
                }
            ).fail(function () {
                failed = true;
            }).always(function () {
                activeRebateRequests = activeRebateRequests.filter(function (xhr) {
                    return xhr !== request;
                });

                if (activeToken !== rebateRefreshToken) return;

                completed++;
                if (completed === rows.length) {
                    $('#chkRebate').prop('disabled', false);
                    renderTable();

                    if (failed) {
                        alert('Some employee rows could not be recalculated.');
                    } else if (previousInfo) {
                        $('#recordInfo').text(previousInfo);
                    }
                }
            });

            activeRebateRequests.push(request);
        });
    }

    function cancelRebateRefresh() {
        rebateRefreshToken++;

        activeRebateRequests.forEach(function (request) {
            if (request && request.readyState !== 4) {
                request.abort();
            }
        });

        activeRebateRequests = [];
        $('#chkRebate').prop('disabled', false);
    }

    function updateProjectionStats(keys) {
        let employeeCount = 0;
        let totalTds = 0;

        keys.forEach(function (year) {
            const row = savedProjectionSummary[year];
            employeeCount += parseInt(row.EmployeeCount || 0, 10);
            totalTds += parseFloat((row.TotalTDS || '0').toString().replace(/,/g, '')) || 0;
        });

        $('#statProjectionYears').text(keys.length);
        $('#statProjectionEmployees').text(employeeCount);
        $('#statProjectionTds').text(totalTds.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        $('#statProjectionStatus').text(keys.length ? 'Ready' : 'Draft');
    }

    function renderProjectionSummary() {
        const keys = Object.keys(savedProjectionSummary).sort(function (a, b) {
            const left = savedProjectionSummary[a];
            const right = savedProjectionSummary[b];
            const yearCompare = (right.FinancialYear || '').toString().localeCompare((left.FinancialYear || '').toString());
            return yearCompare !== 0 ? yearCompare : (left.RegimeId || 0) - (right.RegimeId || 0);
        });
        updateProjectionStats(keys);
        if (keys.length === 0) {
            $('#summaryBody').html('<tr id="summaryEmptyRow"><td colspan="8" class="text-center">No projection saved yet. Click Add Projection.</td></tr>');
            return;
        }

        let html = '';
        keys.forEach(function (year) {
            const row = savedProjectionSummary[year];
            const isFinalized = (row.Status || '').toString().toLowerCase() === 'finalized';
            const displayFinancialYear = row.FinancialYearCode || row.FinancialYear || '';
            html += `<tr>
                <td>${displayFinancialYear}</td>
                <td>${row.RegimeName || ''}</td>
                <td class="text-right">${row.EmployeeCount}</td>
                <td class="text-right">${row.TotalTaxBeforeCess || '0.00'}</td>
                <td class="text-right">${row.TotalCessAmount || '0.00'}</td>
                <td class="text-right">${row.TotalTDS}</td>
                <td>${row.Status || 'Draft'}</td>
                <td class="text-center">
                    <div class="summary-actions">
                        <button type="button" class="btn btn-xs btn-primary" onclick="openProjectionEditor('${row.FinancialYearId || row.FinancialYear || ''}', ${row.RegimeId || 0}, true, '${row.FinancialYear || ''}')">
                            <i class="fa fa-pencil"></i> Edit
                        </button>
                        <button type="button" class="btn btn-xs btn-generate" ${isFinalized ? 'disabled' : ''} onclick="finalizeSummaryProjection('${row.FinancialYear || ''}', ${row.RegimeId || 0}, this)">
                            <i class="fa fa-check"></i> Finalize
                        </button>
                    </div>
                </td>
            </tr>`;
        });
        $('#summaryBody').html(html);
    }

    function finalizeSummaryProjection(financialYear, regimeId, button) {
        if (!financialYear || !regimeId) {
            alert('Unable to finalize: financial year or regime is missing.');
            return;
        }

        if (!confirm('Are you sure you want to finalize this projection?')) {
            return;
        }

        const $btn = $(button);
        $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Finalizing...');

        $.ajax({
            url: '@Url.Action("FinalizeAnnualTdsProjectionSummary", "PayrollTds")',
            type: 'POST',
            data: { FinancialYear: financialYear, RegimeId: regimeId },
            success: function (res) {
                if (!res || !res.success) {
                    alert((res && res.message) ? res.message : 'Unable to finalize projection.');
                    $btn.prop('disabled', false).html('<i class="fa fa-check"></i> Finalize');
                    return;
                }

                alert(res.message || 'Projection finalized successfully.');
                loadProjectionSummaryRows();
            },
            error: function () {
                alert('Server error while finalizing projection.');
                $btn.prop('disabled', false).html('<i class="fa fa-check"></i> Finalize');
            }
        });
    }

    function loadProjectionSummaryRows() {
        $('#summaryBody').html('<tr><td colspan="8" class="text-center"><i class="fa fa-spinner fa-spin"></i> Loading projections...</td></tr>');

        $.getJSON('@Url.Action("GetAnnualTdsProjectionSummary", "PayrollTds")', function (res) {
            Object.keys(savedProjectionSummary).forEach(function (key) {
                delete savedProjectionSummary[key];
            });

            if (!res || !res.success) {
                $('#summaryBody').html(`<tr><td colspan="8" class="text-center text-danger">${(res && res.message) ? res.message : 'Unable to load projection summary.'}</td></tr>`);
                updateProjectionStats([]);
                return;
            }

            (res.Data || []).forEach(function (row) {
                const year = row.FinancialYear;
                if (!year) return;
                const key = `${year}_${row.RegimeId || 0}`;

                savedProjectionSummary[key] = {
                    FinancialYear: year,
                    FinancialYearCode: row.FinancialYearCode || row.FYCode || row.FinYearCode || year,
                    FinancialYearId: row.FinancialYearId || 0,
                    EmployeeCount: row.EmployeeCount || 0,
                    TotalTaxBeforeCess: row.TotalTaxBeforeCess || '0.00',
                    TotalCessAmount: row.TotalCessAmount || '0.00',
                    TotalTDS: row.TotalTDS || '0.00',
                    RegimeId: row.RegimeId || 0,
                    RegimeName: row.RegimeName || '',
                    FinalizedBy: row.FinalizedBy || '',
                    FinalizedOn: row.FinalizedOn || '',
                    Status: row.Status || ''
                };
            });

            renderProjectionSummary();
        }).fail(function () {
            $('#summaryBody').html('<tr><td colspan="8" class="text-center text-danger">Error loading projection summary.</td></tr>');
            updateProjectionStats([]);
        });
    }

    function updateSummaryForCurrentGrid() {
        const year = $('#ddlFY').val();
        if (!year) return;

        const rows = $('#tbodyData tr[data-empid]');
        const employeeCount = rows.length;
        let totalTaxBeforeCess = 0;
        let totalCess = 0;
        let totalTds = 0;

        rows.each(function () {
            totalTaxBeforeCess += cleanNumber($(this).find('.totalBaseTax').text());
            totalCess += cleanNumber($(this).find('.cessAmount').text());
            totalTds += cleanNumber($(this).find('.annualTax').text());
        });

        const regime = $('#ddlRegime').val();
        const key = `${year}_${regime || 0}`;

        savedProjectionSummary[key] = {
            FinancialYear: year,
            RegimeId: regime || '',
            RegimeName: $('#ddlRegime option:selected').text() || '',
            EmployeeCount: employeeCount,
            TotalTaxBeforeCess: totalTaxBeforeCess.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
            TotalCessAmount: totalCess.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
            TotalTDS: totalTds.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
            Status: 'Draft'
        };

        renderProjectionSummary();
    }

    function cleanNumber(val) {
        return parseFloat((val || '0').toString().replace(/₹/g, '').replace(/,/g, '').trim()) || 0;
    }

    function formatNumber(val) {
        return (parseFloat(val) || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    // ---------- Global (Projection) rebate toggle ----------
    $(document).on('change', '#chkRebate', function () {
        if ($(this).is(':checked')) {
            $('#isRebateApplied').val(1);
            $('#rebateText').text('Applied');
        } else {
            $('#isRebateApplied').val(0);
            $('#rebateText').text('Not Applied');
        }

        const companyIds = ($('#ddlCompany').val() || []).filter(v => v !== 'multiselect-all');
        if (companyIds.length > 0 && $('#ddlFY').val()) {
            calculateProjections();
            return;
        }

        refreshProjectionGridForRebate(parseInt($('#isRebateApplied').val() || '0', 10));
    });

    // ---------- Modal employee rebate toggle ----------
    $(document).on('change', '#chkEmpRebate', function () {
        if (!currentEmpId) return;
        const isApplied = $(this).is(':checked') ? 1 : 0;

        recalculateEmployeeTax(currentEmpId, isApplied);
    });

    // ---------- Page init ----------
    $(document).ready(function () {
        $('.multi-select').multiselect({
            includeSelectAllOption: true,
            enableFiltering: true,
            buttonWidth: '100%',
            nonSelectedText: 'Select...',
            maxHeight: 250
        });

        loadInitialFilters();
        loadFY();
        $('#ddlCompany, #ddlDepartment').on('change', function () {
            loadEmployeeByFilters();
        });
        loadProjectionSummaryRows();

        $('#projectionEditorModal').on('click', function (e) {
            if (e.target.id === 'projectionEditorModal') {
                closeProjectionEditor();
            }
        });
    });
    function loadFY(callback) {
        const url = "/PayrollTds/GetFinancialYears";
        const $ddl = $('#ddlFY');

        if ($ddl.children('option').length > 0) {
            if (typeof callback === 'function') callback();
            return $.Deferred().resolve().promise();
        }

        return $.getJSON(url, function (res) {
            $ddl.empty();

            res.forEach(x => {
                const isCurrent = x.isCurrent === true || x.isCurrent === 'true' || x.isCurrent === 1;
                $ddl.append(`<option value="${x.value}" data-current="${isCurrent ? '1' : '0'}">${x.text}</option>`);
            });

            if (typeof callback === 'function') callback();
        });
    }

    function selectCurrentFinancialYear() {
        const $ddl = $('#ddlFY');
        let selectedValue = '';

        $ddl.find('option').each(function () {
            const optionText = ($(this).text() || '').toLowerCase();
            if ($(this).data('current') === 1 || optionText.indexOf('current') >= 0) {
                selectedValue = $(this).val();
                return false;
            }
        });

        if (!selectedValue) {
            selectedValue = $ddl.find('option:first').val() || '';
        }

        if (selectedValue) {
            $ddl.val(selectedValue).trigger('change');
            $ddl.data('financial-year-id', selectedValue);
            $ddl.data('financial-year-code', $ddl.find('option:selected').text() || '');
        }
    }

    function selectFinancialYear(finYearId, financialYearCode) {
        const $ddl = $('#ddlFY');

        if (finYearId) {
            $ddl.val(finYearId);
        }

        if (!$ddl.val() && financialYearCode) {
            $ddl.find('option').each(function () {
                const optionText = ($(this).text() || '').trim();
                const optionValue = ($(this).val() || '').trim();
                if (optionText === financialYearCode || optionText.indexOf(financialYearCode) === 0 || optionValue === financialYearCode) {
                    $ddl.val(optionValue);
                    return false;
                }
            });
        }

        $ddl.data('financial-year-id', $ddl.val() || finYearId || '');
        $ddl.data('financial-year-code', financialYearCode || '');
        $ddl.trigger('change');
    }
    function loadInitialFilters() {
        loadDropdown('/SalaryCTC/GetCompanyList', '#ddlCompany', 'CompanyId', 'CompanyName');
        loadDropdown('/SalaryCTC/GetDepartmentList', '#ddlDepartment', 'DepartmentID', 'DepartmentName'); 
    }

    function loadDropdown(url, ddl, id, text) {
        $.getJSON(url, function (res) {
            const $ddl = $(ddl).empty(); 
            res.forEach(x => $ddl.append(`<option value="${x[id]}">${x[text]}</option>`));
            $ddl.multiselect('rebuild');
        });
    }

    function loadEmployeeByFilters() {
        const companyIds = $('#ddlCompany').val() || [];
        const deptIds = $('#ddlDepartment').val() || [];
        const categoryIds = 1;

        $.ajax({
            url: '/SalaryCTC/GetEmployeeList',
            type: 'GET',
            traditional: true,
            data: { companyIds, deptIds, categoryIds },
            success: function (res) {
                const $ddl = $('#ddlEmployee').empty();
                const activeEmployees = (res || []).filter(x => x.Empstatus === 'ACTIVE');

                activeEmployees.forEach(x => {
                    $ddl.append(`<option value="${x.EmpID}">${x.EmpName} (${x.EmpCode})</option>`);
                });

                $ddl.multiselect('rebuild');
            }
        });
    }

    // ---------- Projection ----------
    function calculateProjections() {
        const activeToken = ++projectionRequestToken;
        cancelRebateRefresh();

        if (activeProjectionRequest && activeProjectionRequest.readyState !== 4) {
            activeProjectionRequest.abort();
        }

        const companyIds = ($('#ddlCompany').val() || []).filter(v => v !== 'multiselect-all');
        const deptIds = ($('#ddlDepartment').val() || []).filter(v => v !== 'multiselect-all');
        const empIds = ($('#ddlEmployee').val() || []).filter(v => v !== 'multiselect-all');
        const isRebateApplied = $('#isRebateApplied').val();
        const year = $('#ddlFY').val();
        const regime = $('#ddlRegime').val();

        if (companyIds.length === 0) {
            alert("Please select at least one Company.");
            return;
        }

        const filters = { companyIds, deptIds, empIds, year, regime, isRebateApplied };

        $('#tbodyData').html('<tr><td colspan="9" class="text-center"><i class="fa fa-spinner fa-spin"></i> Processing Tax Engine...</td></tr>');

        activeProjectionRequest = $.ajax({
            url: "@Url.Action("AnnualTdsProjection", "PayrollTds")",
            type: 'POST',
            data: filters,
            traditional: true,
            timeout: 120000,
            success: function (res) {
                if (activeToken !== projectionRequestToken) return;

                if (!res || !res.success) {
                    $('#tbodyData').html(`<tr><td colspan="9" class="text-center text-danger">${(res && res.message) ? res.message : 'Error'} </td></tr>`);
                    return;
                }

                renderProjectionRows(res.Data || []);
            },
            error: function (xhr, status) {
                if (activeToken !== projectionRequestToken) return;

                const message = status === 'timeout'
                    ? 'Tax Engine request timed out. Please try with fewer employees or check the stored procedure.'
                    : 'Error contacting server.';

                $('#tbodyData').html(`<tr><td colspan="9" class="text-center text-danger">${message}</td></tr>`);
            }
        });
    }

    // ---------- Modal open ----------
    function viewDetails(empId) {
        currentEmpId = empId;

        const year = $('#ddlFY').val() || $('#ddlFY').data('financial-year-id');
        const rowRebate = $('#tbodyData tr[data-empid="' + empId + '"]').find('.rebateApplied').val();
        const appliedRebate = parseInt((rowRebate !== undefined && rowRebate !== '') ? rowRebate : ($('#isRebateApplied').val() || '0'), 10);

        if (!year) {
            alert('Financial year is not loaded. Please reopen the projection and try again.');
            return;
        }

        $('#incomeContainer').html('<p><i class="fa fa-spinner fa-spin"></i> Loading...</p>');
        $('#slabContainer').html('<p><i class="fa fa-spinner fa-spin"></i> Loading...</p>');

        $('#chkEmpRebate').prop('checked', appliedRebate === 1);

        $.post("@Url.Action("GetTdsAudit", "PayrollTds")", { empId: empId, year: year, isRebateApplied: appliedRebate }, function (res) {
            if (!res || !res.success) {
                alert(res && res.message ? res.message : 'Error');
                return;
            }
            renderAuditModal(res);
            $('#tdsModal').addClass('open').hide().fadeIn(200);
        });
    }

    function closeModal() {
        $('#tdsModal').fadeOut(120, function () {
            $(this).removeClass('open');
            clearDetailsModal();
        });
    }

    function clearDetailsModal() {
        currentEmpId = 0;
        $('#lblModalEmpName').text('Employee Detail');
        $('#incomeContainer').empty();
        $('#slabContainer').empty();
        $('#chkEmpRebate').prop('checked', false);
        $('#rebateSection').hide();
        $('#rebateNotApplied').show();
        $('#lblModalAnnualGross').text('0.00');
        $('#lblModalStdDed').text('- 0.00');
        $('#lblModalNetTaxable').text('0.00');
        $('#lblModalBaseTax').text('0.00');
        $('#lblModalCess').text('0.00');
        $('#lblModalMonthlyTDS').text('₹ 0.00');
        $('#lblRebateThreshold').text('₹ 0.00');
        $('#lblRebateLimit').text('₹ 0.00');
        $('#lblTaxAfterRebate').text('₹ 0.00');
    }

    // ---------- Modal recalculation ----------
    function recalculateEmployeeTax(empId, isRebateApplied) {
        const year = getSelectedFinancialYearId();

        $('#slabContainer').html('<p><i class="fa fa-spinner fa-spin"></i> Recalculating...</p>');

        $.post("@Url.Action("GetTdsAudit", "PayrollTds")",
            { empId: empId, year: year, isRebateApplied: isRebateApplied },
            function (res) {
                if (!res || !res.success) {
                    alert(res && res.message ? res.message : 'Error');
                    return;
                }

                renderAuditModal(res);

                updateProjectionRowFromSummary(empId, res.Summary);
            }
        );
    }
    // ---------- Render modal ----------
    function renderAuditModal(res) {
        // Income
        let incomeHtml = '';
        (res.Income || []).forEach(i => {
            incomeHtml += `
                <div class="calc-row">
                    <span>${i.Name}</span>
                    <span>${i.Amount}</span>
                </div>`;
        });
        $('#incomeContainer').html(incomeHtml);

        // Slabs
        let slabHtml = '';
        (res.Slabs || []).forEach(s => {
            // IMPORTANT: use @@ to avoid Razor @@ parsing in cshtml
            slabHtml += `
                <div class="calc-row">
                    <span>${s.Range} @@ ${s.Rate}% (₹ ${s.Salary})</span>
                    <span>${s.Tax}</span>
                </div>`;
        });
        $('#slabContainer').html(slabHtml);

        // Summary
        $('#lblModalEmpName').text(res.EmployeeName || 'Employee Detail');
        $('#lblModalAnnualGross').text(res.Summary?.AnnualGross || '0.00');
        $('#lblModalStdDed').text('- ' + (res.Summary?.StandardDeduction || '0.00'));
        $('#lblModalNetTaxable').text(res.Summary?.NetTaxable || '0.00');

        // Slab total = slab tax before rebate (recommended field)
        const slabTotal = res.Summary?.SlabTaxBeforeRebate || res.Summary?.TotalBaseTax || '0.00';
        $('#lblModalSlabTotal').text(slabTotal);

        $('#lblModalBaseTax').text(res.Summary?.TotalTaxBeforeCess || '0.00');
        $('#lblModalCess').text(res.Summary?.CessAmount || '0.00');
        $('#lblModalMonthlyTDS').text('₹ ' + (res.Summary?.MonthlyTDS || '0.00'));

        // Sync employee toggle based on server
        if (typeof res.Summary?.RebateApplied !== 'undefined') {
            $('#chkEmpRebate').prop('checked', res.Summary.RebateApplied === 1);
        }

        // ---- Rebate Section Control ----
        const rebateApplied = parseInt(res.Summary?.RebateApplied || 0, 10) === 1;

        // Always reset first
        $('#rebateSection').hide();

        if (rebateApplied) {

            $('#lblRebateThreshold').text('₹ ' + (res.Summary?.RebateThreshold || '0.00'));
            $('#lblRebateLimit').text('₹ ' + (res.Summary?.RebateLimit || '0.00'));
            $('#lblTaxAfterRebate').text('₹ ' + (res.Summary?.TaxAfterRebate || res.Summary?.TotalTaxBeforeCess || '0.00'));

            $('#rebateSection').fadeIn(150);
        }
    }

    function finalizeProjection() {

        const year = $('#ddlFY').val();
        const regime = $('#ddlRegime').val();

        const rows = $('#tbodyData tr[data-empid]');
        if (rows.length === 0) {
            alert('No projection data to save.');
            return;
        }

        let projectionData = [];

        rows.each(function () {

            const $row = $(this);

            const empId = $row.data('empid');
            const rebateApplied = parseInt($row.find('.rebateApplied').val() || 0);

            function cleanNumber(val) {
                return parseFloat(
                    val.replace(/₹/g, '')
                        .replace(/,/g, '')
                        .trim()
                ) || 0;
            }
            const annualgross = cleanNumber($row.find('.annualgross').text());
            const nettaxable = cleanNumber($row.find('.nettaxable').text());
            const totalBaseTax = cleanNumber($row.find('.totalBaseTax').text());
            const cessAmount = cleanNumber($row.find('.cessAmount').text());
            const annualTax = cleanNumber($row.find('.annualTax').text());
            const monthlyTds = cleanNumber($row.find('.monthlyTds').text());

            if (annualTax === 0 && monthlyTds === 0) {
                return;
            }

            projectionData.push({
                EmployeeId: empId,
                FinancialYear: year,
                RegimeId: regime,
                AnnualGross: annualgross,
                NetTaxable:nettaxable,
                TotalTaxBeforeCess: totalBaseTax,
                CessAmount: cessAmount,
                AnnualTax: annualTax,
                MonthlyTDS: monthlyTds,

                RebateApplied: rebateApplied
            });
        });

        if (projectionData.length === 0) {
            alert('Nothing to save.');
            return;
        }

        if (!confirm('Are you sure you want to finalize and save this projection?')) {
            return;
        }

        $('#btnFinalize').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Saving...');

        $.ajax({
                url: "@Url.Action("FinalizeTdsProjection", "PayrollTds")",
                type: "POST",
                data: {
                    FinancialYear: year,
                    RegimeId: regime,
                    DataJson: JSON.stringify(projectionData)
                },
                success: function (res) {
                    if (!res.success) {
                        alert(res.message);
                        $('#btnFinalize').prop('disabled', false).html('<i class="fa fa-save"></i> Finalize & Save');
                        return;
                    }
                    loadProjectionSummaryRows();
                    alert("Saved successfully");
                    $('#btnFinalize').prop('disabled', false).html('<i class="fa fa-save"></i> Finalize & Save');
                    closeProjectionEditor();
                },
                error: function (err) {
                    console.log(err);
                    alert("Server error");
                    $('#btnFinalize').prop('disabled', false).html('<i class="fa fa-save"></i> Finalize & Save');
                }
            });
        }
    function lockProjectionUI() {

        $('#btnFinalize').prop('disabled', true);
        $('#chkRebate').prop('disabled', true);
        $('.multi-select').multiselect('disable');

        $('#tblProjections button').prop('disabled', true);

        $('<div class="projection-finalized-message" style="margin-top:10px;color:#2e7d32;font-weight:bold;">Projection Finalized</div>')
            .insertAfter('#paginationContainer');
    }
  </script>
}
