@inherits System.Web.Mvc.WebViewPage
@{
    ViewBag.Title = "Annual Tax Projection";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

<style>
    :root {
        --bg: #f4f5f7;
        --surface: #ffffff;
        --surface2: #f8f9fb;
        --border: #e4e7ec;
        --border2: #d0d5dd;
        --text: #101828;
        --text2: #475467;
        --text3: #98a2b3;
        --accent: #1d4ed8;
        --accent-light: #eff4ff;
        --accent-text: #1e40af;
        --green: #039855;
        --green-bg: #ecfdf3;
        --green-text: #027a48;
        --red: #d92d20;
        --red-bg: #fff1f0;
        --red-text: #b42318;
        --radius: 10px;
        --radius-sm: 6px;
        --shadow: 0 1px 2px rgba(16,24,40,.05), 0 0 0 1px rgba(16,24,40,.06);
        --shadow-modal: 0 8px 32px rgba(16,24,40,.18), 0 0 0 1px rgba(16,24,40,.06);
        --proj-primary: var(--accent);
        --proj-primary-soft: var(--accent-light);
        --proj-accent: var(--green);
        --proj-danger: var(--red);
        --proj-text: var(--text);
        --proj-muted: var(--text2);
        --proj-border: var(--border);
        --proj-panel: var(--surface2);
    }

    body {
        background: var(--bg);
        color: var(--text);
    }

    .page-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 22px;
        gap: 16px;
    }

        .page-header h2 {
            color: var(--text);
            font-weight: 700;
            margin: 0;
        }

    .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        margin-bottom: 20px;
        overflow: hidden;
    }

    .card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px;
        border-bottom: 1px solid var(--border);
        gap: 12px;
    }

    .card-head-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .card-head-icon {
        width: 34px;
        height: 34px;
        background: var(--accent-light);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--accent);
        flex-shrink: 0;
    }

    .card-title {
        font-size: 14px;
        font-weight: 600;
        color: var(--text);
    }

    .card-sub {
        font-size: 12px;
        color: var(--text2);
        margin-top: 1px;
    }

    .stat-bar {
        display: flex;
        gap: 0;
        border-bottom: 1px solid var(--border);
    }

    .stat-item {
        padding: 14px 20px;
        border-right: 1px solid var(--border);
        flex: 1;
    }

        .stat-item:last-child {
            border-right: none;
        }

    .stat-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: var(--text3);
        font-weight: 600;
        margin-bottom: 3px;
    }

    .stat-value {
        font-size: 14px;
        font-weight: 600;
        color: var(--text);
    }

    .tbl-wrap {
        overflow-x: auto;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: var(--radius-sm);
        font-size: 13px;
        font-weight: 500;
        white-space: nowrap;
    }

    .btn-primary {
        background: var(--accent);
        border-color: var(--accent);
        color: #fff;
    }

        .btn-primary:hover {
            background: #1740c4;
            border-color: #1740c4;
        }

    .btn-outline,
    .btn-light,
    .btn-outline-primary {
        background: #fff;
        color: var(--text);
        border: 1px solid var(--border2);
    }

        .btn-outline:hover,
        .btn-light:hover,
        .btn-outline-primary:hover {
            background: var(--bg);
            color: var(--accent-text);
        }

    .summary-card {
        background: var(--surface);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
        margin-bottom: 20px;
        overflow: hidden;
    }

    .summary-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding: 16px 20px;
        margin-bottom: 0;
        border-bottom: 1px solid var(--border);
    }

    .summary-title {
        font-size: 14px;
        font-weight: 600;
        color: var(--text);
    }

    .btn-add-projection {
        border: 1px solid var(--accent);
        border-radius: var(--radius-sm);
        padding: 8px 14px;
        background: var(--accent);
        color: #fff;
        font-size: 13px;
        font-weight: 500;
        transition: background .15s, border-color .15s;
    }

    .btn-add-projection:hover {
        background: #1740c4;
        border-color: #1740c4;
    }

    .tax-card {
        background: #fff;
        border-radius: var(--radius);
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
        padding: 16px;
        margin-bottom: 0;
    }

    .filter-container {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 12px;
        background: var(--proj-panel);
        padding: 14px;
        border-radius: 10px;
        border: 1px solid var(--proj-border);
    }

    .filter-item {
        min-width: 0;
    }

        .filter-item label {
            display: block;
            font-weight: 700;
            font-size: 10px;
            color: var(--proj-muted);
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

    .filter-item select, .btn-action {
            height: 34px !important;
            border-radius: 7px !important;
            font-size: 13px;
            border-color: var(--border2);
        }

    .filter-container .btn-group {
        width: 100%;
    }

    .filter-container .btn-group > .multiselect {
        height: 34px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border2);
        background: #fff;
        color: #334155;
        text-align: left;
    }

    .filter-item-fy {
        grid-column: 1 / span 3;
        grid-row: 1;
    }

    .filter-item-regime {
        grid-column: 4 / span 3;
        grid-row: 1;
    }

    .filter-item-rebate {
        grid-column: 7 / span 3;
        grid-row: 1;
        background: transparent;
        border: none;
        border-radius: 0;
        padding: 0;
    }

    .filter-item-company {
        grid-column: 1 / span 3;
        grid-row: 2;
    }

    .filter-item-department {
        grid-column: 4 / span 3;
        grid-row: 2;
    }

    .filter-item-employee {
        grid-column: 7 / span 3;
        grid-row: 2;
        min-width: 0;
        overflow: hidden;
    }

    .filter-actions {
        grid-column: 10 / span 3;
        grid-row: 1 / span 2;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: stretch;
        gap: 8px;
        min-width: 0;
    }

    .filter-actions-top,
    .filter-actions-bottom {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 6px;
    }

    .filter-actions .btn-action {
        height: 34px !important;
        min-width: 108px;
        padding: 0 10px;
        white-space: nowrap;
        font-size: 12px;
    }

    .filter-item-employee .btn-group > .multiselect {
        width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .btn-generate {
        background: var(--green);
        color: white;
        border: none;
        padding: 0 15px;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
        box-shadow: none;
        transition: .2s;
    }

        .btn-generate:hover {
            filter: brightness(.95);
        }

    .btn-reset {
        background: #fff;
        color: var(--red-text);
        border: 1px solid var(--border2);
        padding: 0 12px;
        cursor: pointer;
        transition: .2s;
    }

        .btn-reset:hover {
            background: var(--red-bg);
        }

    .tax-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 800px;
    }

    .tax-table th {
            background: var(--surface2);
            color: var(--text2);
            padding: 10px 16px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .04em;
            text-align: left;
            border-bottom: 1px solid var(--border);
            border-right: none;
            white-space: nowrap;
        }

        .tax-table td {
            padding: 12px 16px;
            border-bottom: 1px solid var(--border);
            font-size: 13px;
            color: var(--text);
        }

        .tax-table tbody tr:hover {
            background: var(--surface2);
        }

    .text-right {
        text-align: right;
    }

    .bold-blue {
        font-weight: bold;
        color: var(--accent-text);
    }

    .compact-table th,
    .compact-table td {
        padding: 8px;
        font-size: 12px;
    }

    #tblProjectionSummary th,
    #tblProjectionSummary td {
        vertical-align: middle;
    }

    #tblProjectionSummary th:nth-child(3),
    #tblProjectionSummary td:nth-child(3),
    #tblProjectionSummary th:nth-child(4),
    #tblProjectionSummary td:nth-child(4),
    #tblProjectionSummary th:nth-child(5),
    #tblProjectionSummary td:nth-child(5),
    #tblProjectionSummary th:nth-child(6),
    #tblProjectionSummary td:nth-child(6) {
        text-align: right;
    }

    #tblProjectionSummary th:last-child,
    #tblProjectionSummary td:last-child {
        text-align: center;
        width: 170px;
    }

    #tblProjectionSummary .summary-actions {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    #tblProjectionSummary .summary-actions .btn[disabled] {
        opacity: .55;
        cursor: not-allowed;
    }

    /* Modal */
    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(16, 24, 40, 0.55);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 24px;
        backdrop-filter: blur(2px);
    }

    .modal-overlay.open {
        display: flex !important;
    }

    .modal-card {
        background: var(--surface);
        width: 900px;
        max-width: calc(100% - 30px);
        border-radius: 14px;
        box-shadow: var(--shadow-modal);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        max-height: 90vh;
    }

    .editor-modal-card {
        background: var(--surface);
        width: 1180px;
        max-width: calc(100% - 40px);
        border-radius: 14px;
        box-shadow: var(--shadow-modal);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        max-height: 90vh;
    }

    .editor-modal-header {
        background: var(--surface);
        color: var(--text);
        padding: 12px 16px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .editor-modal-header small {
            color: var(--text2);
        }

    .editor-modal-body {
        padding: 22px;
        background: var(--surface);
        overflow: auto;
    }

    .editor-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 10px;
        gap: 10px;
        flex-wrap: wrap;
    }

    .editor-toolbar-search input {
        width: 280px;
        max-width: 100%;
        border-radius: 8px;
    }

    .editor-toolbar-page select {
        width: 110px;
        border-radius: 8px;
    }

    #btnFinalize {
        background: var(--accent);
        border: none;
        box-shadow: none;
        min-width: 128px;
    }

    .modal-header {
        background: var(--surface);
        color: var(--text);
        padding: 12px 16px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-header small {
        color: var(--text2);
    }

    .btn-close {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: transparent;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text2);
        font-size: 18px;
        line-height: 1;
        flex-shrink: 0;
    }

        .btn-close:hover {
            background: var(--bg);
        }

    .modal-body {
        padding: 22px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
        max-height: 70vh;
        overflow-y: auto;
    }

    .section-title {
        font-weight: bold;
        color: var(--text2);
        border-bottom: 1px solid var(--border);
        padding-bottom: 10px;
        margin-bottom: 16px;
        text-transform: uppercase;
        font-size: 12px;
    }

    .calc-row {
        display: flex;
        justify-content: space-between;
        padding: 6px 0;
        border-bottom: 1px dashed #f1f5f9;
        font-size: 13px;
    }

    .total-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        font-weight: bold;
        border-top: 2px solid #1a237e;
        margin-top: 10px;
        color: #1a237e;
    }

    .tax-result-box {
        background: var(--surface2);
        border: 1px solid var(--border);
        padding: 15px;
        border-radius: 8px;
        text-align: center;
        margin-top: 20px;
    }

    .monthly-val {
        font-size: 24px;
        font-weight: 800;
        color: var(--accent-text);
        margin: 5px 0;
    }

    /* Toggle */
    .rebate-toggle {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 3px;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 42px;
        height: 22px;
        flex: 0 0 auto;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #c62828;
        transition: .3s;
        border-radius: 22px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 2px;
            bottom: 2px;
            background-color: white;
            transition: .3s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #2e7d32;
    }

        input:checked + .slider:before {
            transform: translateX(20px);
        }

    .toggle-text {
        font-size: 12px;
        font-weight: 600;
        color: #64748b;
    }

    @@media(max-width: 767px) {
        .summary-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .filter-item-fy,
        .filter-item-regime,
        .filter-item-rebate,
        .filter-item-company,
        .filter-item-department,
        .filter-item-employee,
        .filter-actions {
            grid-column: 1 / -1;
        }

        .filter-actions {
            justify-content: flex-start;
            grid-row: auto;
            gap: 6px;
        }

        .filter-actions-top,
        .filter-actions-bottom {
            justify-content: flex-start;
        }

        .editor-toolbar-search input {
            width: 100%;
        }

        .modal-body {
            grid-template-columns: 1fr;
        }

        .editor-modal-card {
            max-width: calc(100% - 18px);
            margin: 10px auto;
        }

        .editor-modal-body {
            padding: 10px;
            max-height: calc(100vh - 90px);
        }
    }
    .rebate-section {
        display: none;
        margin-top: 15px;
    }
</style>

<section class="content-body">
    <header class="page-header">
        <h2>Annual Tax Projection</h2>
    </header>

    <div class="card summary-card">
        <div class="card-head">
            <div class="card-head-left">
                <div class="card-head-icon">
                    <i class="fa fa-line-chart"></i>
                </div>
                <div>
                    <div class="card-title">Yearly Projection Summary</div>
                    <div class="card-sub">Generate, review, audit, and finalize employee TDS projections</div>
                </div>
            </div>
            <button type="button" class="btn-add-projection" onclick="openProjectionEditor()">
                <i class="fa fa-plus"></i> Add Projection
            </button>
        </div>

        <div class="stat-bar" id="projectionStatBar">
            <div class="stat-item"><div class="stat-label">Projection Years</div><div class="stat-value" id="statProjectionYears">0</div></div>
            <div class="stat-item"><div class="stat-label">Employees</div><div class="stat-value" id="statProjectionEmployees">0</div></div>
            <div class="stat-item"><div class="stat-label">Total TDS</div><div class="stat-value" id="statProjectionTds">0.00</div></div>
            <div class="stat-item"><div class="stat-label">Status</div><div class="stat-value" id="statProjectionStatus">Draft</div></div>
        </div>

        <div class="tbl-wrap">
            <table class="tax-table compact-table" id="tblProjectionSummary">
                <thead>
                    <tr>
                        <th>Financial Year</th>
                        <th>Regime Name</th>
                        <th class="text-right">Employees</th>
                        <th class="text-right">Tax Before Cess (Total)</th>
                        <th class="text-right">Cess (Total)</th>
                        <th class="text-right">Total TDS</th>
                        <th>Status</th>
                        <th style="text-align:center;">Action</th>
                    </tr>
                </thead>
                <tbody id="summaryBody">
                    <tr id="summaryEmptyRow">
                        <td colspan="8" class="text-center">No projection saved yet. Click Add Projection.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

<div class="modal-overlay" id="projectionEditorModal">
    <div class="editor-modal-card">
        <div class="editor-modal-header">
            <div>
                <h4 style="margin:0; font-size:15px;">Projection Editor</h4>
                <small style="opacity:0.9;">Add or edit yearly annual tax projection</small>
            </div>
            <button type="button" class="btn-close" onclick="closeProjectionEditor()">&times;</button>
        </div>
        <div class="editor-modal-body">
            <div class="tax-card">
                <div class="filter-container">
                    <div class="filter-item filter-item-fy">
                        <label>FY Year</label>
                        <select id="ddlFY" class="form-control"></select>
                    </div>

                    <div class="filter-item filter-item-regime">
                        <label>Regime</label>
                        <select id="ddlRegime" class="form-control" disabled style="background-color: #f1f3f5;">
                            <option value="2">New Tax Regime</option>
                        </select>
                    </div>

                    <input type="hidden" name="isRebateApplied" id="isRebateApplied" value="0" />

                    <div class="filter-item filter-item-rebate">
                        <label>Section 87A Rebate</label>
                        <div class="rebate-toggle">
                            <label class="switch">
                                <input type="checkbox" id="chkRebate">
                                <span class="slider"></span>
                            </label>
                            <span class="toggle-text" id="rebateText">Not Applied</span>
                        </div>
                    </div>

                    <div class="filter-item filter-item-company">
                        <label>Company</label>
                        <select id="ddlCompany" class="form-control multi-select" multiple="multiple"></select>
                    </div>

                    <div class="filter-item filter-item-department">
                        <label>Department</label>
                        <select id="ddlDepartment" class="form-control multi-select" multiple="multiple"></select>
                    </div>

                    <div class="filter-item filter-item-employee">
                        <label>Employee</label>
                        <select id="ddlEmployee" class="form-control multi-select" multiple="multiple"></select>
                    </div>

                    <div class="filter-item filter-actions">
                        <div class="filter-actions-top">
                            <button type="button" class="btn-reset btn-action" onclick="location.reload()" title="Reset Filters">
                                <i class="fa fa-refresh"></i> Reset
                            </button>
                        </div>
                        <div class="filter-actions-bottom">
                            <button type="button" class="btn-generate btn-action" onclick="calculateProjections()">
                                <i class="fa fa-calculator"></i> Generate
                            </button>
                            <button type="button" class="btn btn-primary btn-action" id="btnFinalize" onclick="finalizeProjection()">
                                <i class="fa fa-save"></i> Finalize & Save
                            </button>
                        </div>
                    </div>
                </div>
                <div class="editor-toolbar">
                    <div class="editor-toolbar-search">
                        <input type="text" id="txtSearch" class="form-control" placeholder="Search employee...">
                    </div>
                    <div class="editor-toolbar-page">
                        <select id="ddlPageSize" class="form-control">
                            <option value="5">5</option>
                            <option value="10" selected>10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                    </div>
                </div>

                <div class="tbl-wrap">
                    <table class="tax-table compact-table" id="tblProjections">
                        <thead>
                            <tr>
                                <th>Emp ID</th>
                                <th>Name</th>
                                <th class="text-right">Annual Gross</th>
                                <th class="text-right">Net Taxable</th>
                                <th class="text-right">Total Tax (Before Cess)</th>
                                <th class="text-right">Cess Amount</th>
                                <th class="text-right">Annual Tax</th>
                                <th class="text-right">Monthly TDS</th>
                                <th style="text-align:center">Audit</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyData">
                            <tr><td colspan="9" class="text-center">Select filters and click Generate.</td></tr>
                        </tbody>
                    </table>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center; margin-top:4px; gap:10px; flex-wrap:wrap;">
                    <div id="recordInfo" style="font-size:12px; color:#64748b; margin-bottom:8px;"></div>
                    <div id="paginationContainer" style="text-align:center; margin-top:15px;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal-overlay" id="tdsModal">
    <div class="modal-card">
        <div class="modal-header">
            <div>
                <h3 style="margin:0">TDS Projection Detail (New Tax Regime - Section 115BAC)</h3>
                <small id="lblModalEmpName">Employee Detail</small>
            </div>
