@{
    ViewBag.Title = "Payroll Cycle Configuration";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .payroll-cycle-panel {
        border-top: 3px solid #0E7777;
    }

    .payroll-cycle-description {
        margin-bottom: 18px;
        color: #666;
        font-size: 13px;
    }

    .payroll-section-title {
        margin: 0 0 10px;
        color: #475569;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
    }

    .payroll-cycle-option-tile {
        display: block;
        min-height: 122px;
        margin-bottom: 22px;
        padding: 16px 16px 20px;
        border: 1px solid #d9e2ec;
        border-radius: 4px;
        background: #fff;
        cursor: pointer;
        font-weight: normal;
        transition: all .15s ease;
    }

        .payroll-cycle-option-tile:hover {
            border-color: #9fb3c8;
            background: #fbfdff;
        }

        .payroll-cycle-option-tile.active {
            border-color: #0E7777;
            background: #eefafa;
            box-shadow: inset 0 0 0 1px #0E7777;
        }

        .payroll-cycle-option-tile input[type="radio"] {
            margin: 3px 10px 0 0;
            float: left;
        }

    .payroll-cycle-option-content {
        display: block;
        overflow: hidden;
    }

    .payroll-cycle-option-icon {
        display: inline-block;
        width: 28px;
        height: 28px;
        margin-right: 6px;
        border-radius: 50%;
        background: #0E7777;
        color: #fff;
        text-align: center;
        line-height: 28px;
    }

    .payroll-cycle-option-title {
        display: block;
        margin-bottom: 6px;
        color: #333;
        font-size: 14px;
        font-weight: 600;
    }

    .payroll-cycle-option-desc {
        display: block;
        padding-bottom: 4px;
        color: #777;
        font-size: 12px;
        line-height: 1.5;
    }

    .payroll-cycle-field-band {
        margin-bottom: 18px;
        padding: 18px 18px 6px;
        border: 1px solid #e6edf3;
        background: #f8fbfb;
    }

        .payroll-cycle-field-band .row {
            margin-left: -10px;
            margin-right: -10px;
        }

        .payroll-cycle-field-band [class*="col-"] {
            padding-left: 10px;
            padding-right: 10px;
        }

        .payroll-cycle-field-band .form-group {
            margin-bottom: 16px;
        }

        .payroll-cycle-field-band .control-label {
            color: #42526e;
            font-size: 12px;
            font-weight: 600;
        }

    .payroll-preview-box {
        padding: 16px;
        border: 1px dashed #b8c7d7;
        border-radius: 4px;
        background: #f8fafc;
    }

    .payroll-preview-label {
        display: block;
        margin-bottom: 5px;
        color: #777;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .payroll-preview-value,
    .payroll-preview-date {
        color: #0f172a;
        font-size: 15px;
        font-weight: 600;
    }

    .payroll-preview-heading {
        margin-bottom: 14px;
        color: #333;
        font-weight: 600;
    }

        .payroll-preview-heading i {
            margin-right: 5px;
            color: #0E7777;
        }

    .payroll-preview-arrow {
        color: #94a3b8;
        font-size: 18px;
        line-height: 42px;
    }

    .payroll-preview-note {
        margin: 12px 0 0;
        color: #777;
        font-size: 12px;
    }

    .payroll-grid-empty {
        padding: 24px;
        color: #777;
        text-align: center;
    }

    .payroll-status-badge {
        display: inline-block;
        padding: 3px 8px;
        border-radius: 10px;
        background: #e8f5e9;
        color: #2e7d32;
        font-size: 11px;
        font-weight: 600;
    }

    .payroll-source-toggle-box {
        margin-bottom: 18px;
        padding: 14px 16px;
        border: 1px solid #d9e2ec;
        border-left: 3px solid #0E7777;
        border-radius: 4px;
        background: #f8fbfb;
    }

    .payroll-source-toggle-box .toggle-copy {
        color: #64748b;
        font-size: 12px;
        line-height: 1.5;
    }

    .payroll-toggle-switch {
        position: relative;
        display: inline-block;
        width: 54px;
        height: 28px;
        margin: 0 10px;
        vertical-align: middle;
    }

    .payroll-toggle-switch input {
        display: none;
    }

    .payroll-toggle-slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        border-radius: 14px;
        background: #cbd5e1;
        transition: .2s;
    }

    .payroll-toggle-slider:before {
        position: absolute;
        content: "";
        width: 22px;
        height: 22px;
        left: 3px;
        bottom: 3px;
        border-radius: 50%;
        background: #fff;
        transition: .2s;
        box-shadow: 0 1px 3px rgba(0,0,0,.2);
    }

    .payroll-toggle-switch input:checked + .payroll-toggle-slider {
        background: #0E7777;
    }

    .payroll-toggle-switch input:checked + .payroll-toggle-slider:before {
        transform: translateX(26px);
    }

    .payroll-source-label {
        color: #334155;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        vertical-align: middle;
    }

    .payroll-source-label.active {
        color: #0E7777;
    }
</style>

<section role="main" class="content-body">
    <header class="page-header">
        <h2>Payroll Cycle Configuration</h2>
    </header>

    <section class="panel payroll-cycle-panel">
        <header class="panel-heading">
            <div class="pull-right">
                <button type="button" id="btnAddPayrollCycle" class="btn btn-primary btn-sm">
                    <i class="fa fa-plus"></i>
                    Add Configuration
                </button>
            </div>
            <h2 class="panel-title">
                <i class="fa fa-calendar text-primary"></i>
                Payroll Cycle Configuration
            </h2>
        </header>

        <div class="panel-body">
            <p class="payroll-cycle-description">
                Saved payroll cycle configurations are shown below. Use Add Configuration to create a new setup, or edit an existing row.
            </p>

            <div class="table-responsive">
                <table class="table table-bordered table-striped table-condensed" id="tblPayrollCycleConfiguration">
                    <thead>
                        <tr>
                            <th style="width:70px;">#</th>
                            <th>Payroll Type</th>
                            <th>Cycle Type</th>
                            <th>Start Day</th>
                            <th>End Day</th>
                            <th>Period</th>
                            <th>Paid Days Source</th>
                            <th>Status</th>
                            <th>Created On</th>
                            <th style="width:110px; text-align:center;">Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </section>
</section>

<div id="payrollCycleModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background:#0E7777; color:#fff;">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color:#fff; opacity:1;">&times;</button>
                <h4 class="modal-title" id="payrollCycleModalTitle">
                    <i class="fa fa-calendar"></i>
                    Add Payroll Cycle Configuration
                </h4>
            </div>

            <div class="modal-body">
                <input type="hidden" id="PayrollConfigID" value="0" />

                <div class="payroll-section-title">Salary Days Configuration</div>
                <div class="payroll-source-toggle-box">
                    <div class="row">
                        <div class="col-md-7 col-sm-7">
                            <strong>Paid Days Source</strong>
                            <div class="toggle-copy">
                                Choose whether salary paid days come from payroll period days or attendance data.
                            </div>
                        </div>
                        <div class="col-md-5 col-sm-5 text-right">
                            <span id="monthDataLabel" class="payroll-source-label active">Month Data</span>
                            <label class="payroll-toggle-switch" title="Use Attendance Data">
                                <input type="checkbox" id="useAttendanceData" />
                                <span class="payroll-toggle-slider"></span>
                            </label>
                            <span id="attendanceDataLabel" class="payroll-source-label">Attendance</span>
                        </div>
                    </div>
                </div>

                <div class="payroll-section-title">Payroll Type</div>
                <div class="row">
                    <div class="col-md-6">
                        <label class="payroll-cycle-option-tile" for="typeMonthly">
                            <input type="radio" name="PayrollType" id="typeMonthly" value="1" />
                            <span class="payroll-cycle-option-content">
                                <span class="payroll-cycle-option-title">
                                    <span class="payroll-cycle-option-icon"><i class="fa fa-calendar"></i></span>
                                    Monthly Payroll
                                </span>
                                <span class="payroll-cycle-option-desc">
                                    Salary is processed using Calendar Month or a Fixed Payroll Cycle.
                                </span>
                            </span>
                        </label>
                    </div>
                    <div class="col-md-6">
                        <label class="payroll-cycle-option-tile" for="typeContractual">
                            <input type="radio" name="PayrollType" id="typeContractual" value="2" />
                            <span class="payroll-cycle-option-content">
                                <span class="payroll-cycle-option-title">
                                    <span class="payroll-cycle-option-icon"><i class="fa fa-file-text-o"></i></span>
                                    Contractual Payroll
                                </span>
                                <span class="payroll-cycle-option-desc">
                                    Salary processing users will manually select From Date and To Date.
                                </span>
                            </span>
                        </label>
                    </div>
                </div>

                <div id="monthlyPayrollBlock">
                    <div class="payroll-section-title">Payroll Cycle Type</div>
                    <div class="row">
                        <div class="col-md-6">
                            <label class="payroll-cycle-option-tile" for="cycleCalendar">
                                <input type="radio" name="PayrollCycleType" id="cycleCalendar" value="1" />
                                <span class="payroll-cycle-option-content">
                                    <span class="payroll-cycle-option-title">
                                        <span class="payroll-cycle-option-icon"><i class="fa fa-calendar-o"></i></span>
                                        Calendar Month
                                    </span>
                                    <span class="payroll-cycle-option-desc">
                                        Salary will be processed from the 1st day to the last day of the selected month.
                                    </span>
                                </span>
                            </label>
                        </div>
                        <div class="col-md-6">
                            <label class="payroll-cycle-option-tile" for="cycleFixed">
                                <input type="radio" name="PayrollCycleType" id="cycleFixed" value="2" />
                                <span class="payroll-cycle-option-content">
                                    <span class="payroll-cycle-option-title">
                                        <span class="payroll-cycle-option-icon"><i class="fa fa-calendar-check-o"></i></span>
                                        Fixed Payroll Cycle
                                    </span>
                                    <span class="payroll-cycle-option-desc">
                                        Salary will be processed between configured Start Day and End Day every month.
                                    </span>
                                </span>
                            </label>
                        </div>
                    </div>

                    <div id="calendarMonthAlert" class="alert alert-info" style="display:none;">
                        <i class="fa fa-info-circle"></i>
                        Payroll will always be calculated from the first day to the last day of the selected month.
                    </div>

                    <div class="payroll-section-title">Payroll Cycle Details</div>
                    <div class="payroll-cycle-field-band">
                        <div class="row">
                            <div class="col-md-4 col-sm-4" id="startDayColumn">
                                <div class="form-group">
                                    <label for="payrollStartDay" class="control-label">Payroll Starts On</label>
                                    <select id="payrollStartDay" class="form-control">
                                        <option value="">Select Day</option>
                                        @for (int day = 1; day <= 31; day++)
                                        {
                                            <option value="@day">@day</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4" id="endDayColumn">
                                <div class="form-group">
                                    <label for="payrollEndDay" class="control-label">Payroll Ends On</label>
                                    <select id="payrollEndDay" class="form-control">
                                        <option value="">Select Day</option>
                                        @for (int day = 1; day <= 31; day++)
                                        {
                                            <option value="@day">@day</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4">
                                <div class="form-group">
                                    <label for="examplePayrollMonth" class="control-label">Example Payroll Month</label>
                                    <input type="month" id="examplePayrollMonth" class="form-control" value="@DateTime.Now.ToString("yyyy-MM")" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="payroll-section-title">Payroll Period Preview</div>
                    <div class="payroll-preview-box">
                        <div class="payroll-preview-heading">
                            <i class="fa fa-eye"></i>
                            Payroll Period Preview
                        </div>

                        <div class="row">
                            <div class="col-md-3 col-sm-4">
                                <span class="payroll-preview-label">Payroll Month</span>
                                <div class="payroll-preview-value" id="previewPayrollMonth">-</div>
                            </div>
                            <div class="col-md-1 hidden-sm hidden-xs text-center">
                                <span class="payroll-preview-arrow"><i class="fa fa-long-arrow-right"></i></span>
                            </div>
                            <div class="col-md-4 col-sm-4">
                                <span class="payroll-preview-label">From</span>
                                <div class="payroll-preview-date" id="previewFromDate">-</div>
                            </div>
                            <div class="col-md-4 col-sm-4">
                                <span class="payroll-preview-label">To</span>
                                <div class="payroll-preview-date" id="previewToDate">-</div>
                            </div>
                        </div>

                        <p class="payroll-preview-note">
                            <i class="fa fa-info-circle"></i>
                            Changing the payroll month or start/end day will automatically update the preview.
                        </p>
                    </div>
                </div>

                <div id="contractualPayrollBlock" class="alert alert-info" style="display:none;">
                    <i class="fa fa-info-circle"></i>
                    Contractual payroll does not require payroll cycle dates. Users will select From Date and To Date during salary processing.
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">
                    <i class="fa fa-times"></i>
                    Cancel
                </button>
                <button type="button" id="btnResetPayrollCycle" class="btn btn-default">
                    <i class="fa fa-refresh"></i>
                    Reset
                </button>
                <button type="button" id="btnSavePayrollCycle" class="btn btn-primary">
                    <i class="fa fa-save"></i>
                    Save Configuration
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toastr -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script>
    $(function () {
        var monthNames = [
            "January", "February", "March", "April", "May", "June",
            "July", "August", "September", "October", "November", "December"
        ];

        if (window.toastr) {
            toastr.options = {
                closeButton: true,
                progressBar: true,
                positionClass: "toast-top-right",
                timeOut: "3500",
                extendedTimeOut: "1000"
            };
        }

        function showMessage(type, message) {
            if (window.toastr && toastr[type]) {
                toastr[type](message);
            } else {
                alert(message);
            }
        }

        function pad(value) {
            return value < 10 ? "0" + value : value;
        }

        function getLastDay(year, monthIndex) {
            return new Date(year, monthIndex + 1, 0).getDate();
        }

        function clampDay(year, monthIndex, day) {
            return Math.min(day, getLastDay(year, monthIndex));
        }

        function formatMonthYear(year, monthIndex) {
            return monthNames[monthIndex] + " " + year;
        }

        function formatDate(date) {
            return pad(date.getDate()) + "-" + monthNames[date.getMonth()].substr(0, 3) + "-" + date.getFullYear();
        }

        function getCurrentMonthValue() {
            var today = new Date();
            return today.getFullYear() + "-" + pad(today.getMonth() + 1);
        }

        function getSelectedMonthParts() {
            var monthValue = $("#examplePayrollMonth").val() || getCurrentMonthValue();
            var parts = monthValue.split("-");

            return {
                year: parseInt(parts[0], 10),
                monthIndex: parseInt(parts[1], 10) - 1
            };
        }

        function updateTileSelection(groupName) {
            $("input[name='" + groupName + "']").closest(".payroll-cycle-option-tile").removeClass("active");
            $("input[name='" + groupName + "']:checked").closest(".payroll-cycle-option-tile").addClass("active");
        }

        function updatePaidDaysSourceToggle() {
            var useAttendance = $("#useAttendanceData").is(":checked");
            $("#attendanceDataLabel").toggleClass("active", useAttendance);
            $("#monthDataLabel").toggleClass("active", !useAttendance);
        }

        function updateModalVisibility() {
            var isMonthly = $("#typeMonthly").is(":checked");
            var isFixedCycle = $("#cycleFixed").is(":checked");
            var hasPayrollType = $("input[name='PayrollType']:checked").length > 0;

            $("#monthlyPayrollBlock").toggle(hasPayrollType && isMonthly);
            $("#contractualPayrollBlock").toggle(hasPayrollType && !isMonthly);
            $("#startDayColumn, #endDayColumn").toggle(isMonthly && isFixedCycle);
            $("#calendarMonthAlert").toggle(isMonthly && !isFixedCycle);

            updateTileSelection("PayrollType");
            updateTileSelection("PayrollCycleType");
            updatePayrollPreview();
        }

        function updatePayrollPreview() {
            if (!$("#typeMonthly").is(":checked")) {
                return;
            }

            var selectedMonth = getSelectedMonthParts();
            var year = selectedMonth.year;
            var monthIndex = selectedMonth.monthIndex;
            var isFixedCycle = $("#cycleFixed").is(":checked");
            var fromDate;
            var toDate;

            if (!$("input[name='PayrollCycleType']:checked").length) {
                $("#previewPayrollMonth, #previewFromDate, #previewToDate").text("-");
                return;
            }

            if (isFixedCycle) {
                var startDay = parseInt($("#payrollStartDay").val(), 10);
                var endDay = parseInt($("#payrollEndDay").val(), 10);

                if (!startDay || !endDay) {
                    $("#previewPayrollMonth").text(formatMonthYear(year, monthIndex));
                    $("#previewFromDate, #previewToDate").text("-");
                    return;
                }

                var startMonthIndex = monthIndex - 1;
                var startYear = year;

                if (startMonthIndex < 0) {
                    startMonthIndex = 11;
                    startYear = year - 1;
                }

                fromDate = new Date(startYear, startMonthIndex, clampDay(startYear, startMonthIndex, startDay));
                toDate = new Date(year, monthIndex, clampDay(year, monthIndex, endDay));
            } else {
                fromDate = new Date(year, monthIndex, 1);
                toDate = new Date(year, monthIndex, getLastDay(year, monthIndex));
            }

            $("#previewPayrollMonth").text(formatMonthYear(year, monthIndex));
            $("#previewFromDate").text(formatDate(fromDate));
            $("#previewToDate").text(formatDate(toDate));
        }

        function resetPayrollCycleForm() {
            $("#PayrollConfigID").val("0");
            $("input[name='PayrollType'], input[name='PayrollCycleType']").prop("checked", false);
            $("#payrollStartDay").val("");
            $("#payrollEndDay").val("");
            $("#examplePayrollMonth").val("");
            $("#useAttendanceData").prop("checked", false);
            $("#payrollCycleModalTitle").html('<i class="fa fa-calendar"></i> Add Payroll Cycle Configuration');
            updatePaidDaysSourceToggle();
            updateModalVisibility();
        }

        function loadPayrollCycleGrid() {
            var tbody = $("#tblPayrollCycleConfiguration tbody");
            tbody.html('<tr><td colspan="10" class="payroll-grid-empty">Loading payroll cycle configurations...</td></tr>');

            $.ajax({
                url: "/SalaryConfig/GetPayrollCycleConfigurations",
                type: "GET",
                success: function (res) {
                    tbody.empty();

                    if (!res.Success) {
                        tbody.html('<tr><td colspan="10" class="payroll-grid-empty text-danger">' + res.Message + '</td></tr>');
                        showMessage("error", res.Message || "Unable to load payroll cycle configurations.");
                        return;
                    }

                    if (!res.Data || res.Data.length === 0) {
                        tbody.html('<tr><td colspan="10" class="payroll-grid-empty">No payroll cycle configuration saved yet.</td></tr>');
                        return;
                    }

                    $.each(res.Data, function (index, row) {
                        tbody.append(
                            '<tr>' +
                            '<td>' + (index + 1) + '</td>' +
                            '<td>' + row.TypeName + '</td>' +
                            '<td>' + row.PayrollCycleTypeName + '</td>' +
                            '<td>' + (row.StartDay || '-') + '</td>' +
                            '<td>' + (row.EndDay || '-') + '</td>' +
                            '<td>' + row.PeriodText + '</td>' +
                            '<td>' + row.PaidDaysSourceName + '</td>' +
                            '<td><span class="payroll-status-badge">Active</span></td>' +
                            '<td>' + row.CreatedOn + '</td>' +
                            '<td class="text-center">' +
                            '<button type="button" class="btn btn-xs btn-default" title="Edit" onclick="editPayrollCycleConfiguration(' + row.PayrollConfigID + ')"><i class="fa fa-pencil text-primary"></i></button> ' +
                            '<button type="button" class="btn btn-xs btn-default" title="Delete" onclick="deletePayrollCycleConfiguration(' + row.PayrollConfigID + ')"><i class="fa fa-trash text-danger"></i></button>' +
                            '</td>' +
                            '</tr>'
                        );
                    });
                },
                error: function () {
                    tbody.html('<tr><td colspan="10" class="payroll-grid-empty text-danger">Unable to load payroll cycle configurations.</td></tr>');
                    showMessage("error", "Unable to load payroll cycle configurations.");
                }
            });
        }

        function buildSavePayload() {
            var typeId = parseInt($("input[name='PayrollType']:checked").val(), 10);
            var cycleType = typeId === 1 ? parseInt($("input[name='PayrollCycleType']:checked").val(), 10) : null;

            if (!typeId) {
                showMessage("warning", "Select Payroll Type.");
                return null;
            }

            if (typeId === 1 && !cycleType) {
                showMessage("warning", "Select Payroll Cycle Type.");
                return null;
            }

            if (typeId === 1 && cycleType === 2 && (!$("#payrollStartDay").val() || !$("#payrollEndDay").val())) {
                showMessage("warning", "Select Payroll Starts On and Payroll Ends On.");
                return null;
            }

            return {
                PayrollConfigID: parseInt($("#PayrollConfigID").val(), 10) || 0,
                TypeID: typeId,
                PayrollCycleType: cycleType,
                StartDay: typeId === 1 && cycleType === 2 ? parseInt($("#payrollStartDay").val(), 10) : null,
                EndDay: typeId === 1 && cycleType === 2 ? parseInt($("#payrollEndDay").val(), 10) : null,
                PaidDaysSource: $("#useAttendanceData").is(":checked") ? 2 : 1
            };
        }

        window.editPayrollCycleConfiguration = function (id) {
            $.ajax({
                url: "/SalaryConfig/GetPayrollCycleConfiguration",
                type: "GET",
                data: { id: id },
                success: function (res) {
                    if (!res.Success) {
                        showMessage("error", res.Message || "Unable to load payroll cycle configuration.");
                        return;
                    }

                    var data = res.Data;
                    resetPayrollCycleForm();

                    $("#PayrollConfigID").val(data.PayrollConfigID);
                    $("input[name='PayrollType'][value='" + data.TypeID + "']").prop("checked", true);
                    $("#useAttendanceData").prop("checked", data.PaidDaysSource === 2);
                    updatePaidDaysSourceToggle();

                    if (data.TypeID === 1) {
                        $("input[name='PayrollCycleType'][value='" + data.PayrollCycleType + "']").prop("checked", true);

                        if (data.StartDay) {
                            $("#payrollStartDay").val(data.StartDay);
                        }

                        if (data.EndDay) {
                            $("#payrollEndDay").val(data.EndDay);
                        }

                        if (!$("#examplePayrollMonth").val()) {
                            $("#examplePayrollMonth").val(getCurrentMonthValue());
                        }
                    }

                    $("#payrollCycleModalTitle").html('<i class="fa fa-calendar"></i> Edit Payroll Cycle Configuration');
                    updateModalVisibility();
                    $("#payrollCycleModal").modal("show");
                },
                error: function () {
                    showMessage("error", "Unable to load payroll cycle configuration.");
                }
            });
        };

        window.deletePayrollCycleConfiguration = function (id) {
            if (!confirm("Are you sure you want to delete this payroll cycle configuration?")) {
                return;
            }

            $.ajax({
                url: "/SalaryConfig/DeletePayrollCycleConfiguration",
                type: "POST",
                data: { id: id },
                success: function (res) {
                    if (res.Success) {
                        showMessage("success", res.Message || "Payroll cycle configuration deleted successfully.");
                        loadPayrollCycleGrid();
                    } else {
                        showMessage("error", res.Message || "Unable to delete payroll cycle configuration.");
                    }
                },
                error: function () {
                    showMessage("error", "Unable to delete payroll cycle configuration.");
                }
            });
        };

        $("#btnAddPayrollCycle").on("click", function () {
            resetPayrollCycleForm();
            $("#payrollCycleModal").modal("show");
        });

        $("#btnResetPayrollCycle").on("click", resetPayrollCycleForm);
        $("#useAttendanceData").on("change", updatePaidDaysSourceToggle);

        $("#btnSavePayrollCycle").on("click", function () {
            var payload = buildSavePayload();

            if (!payload) {
                return;
            }

            $.ajax({
                url: "/SalaryConfig/SavePayrollCycleConfiguration",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.Success) {
                        $("#payrollCycleModal").modal("hide");
                        showMessage("success", res.Message || "Payroll cycle configuration saved successfully.");
                        loadPayrollCycleGrid();
                    } else {
                        showMessage("error", res.Message || "Unable to save payroll cycle configuration.");
                    }
                },
                error: function () {
                    showMessage("error", "Unable to save payroll cycle configuration.");
                }
            });
        });

        $("input[name='PayrollType'], input[name='PayrollCycleType'], #payrollStartDay, #payrollEndDay, #examplePayrollMonth").on("change", updateModalVisibility);

        loadPayrollCycleGrid();
        resetPayrollCycleForm();
    });
</script>
