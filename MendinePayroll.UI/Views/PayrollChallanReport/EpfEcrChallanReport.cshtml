            padding: 6px !important;
            height: 31px !important;
            width: 88px !important;
            border: 1px solid #a89d9d;
            float: right;
        }

        #pagination li a {
            color: #007bff;
            border: 1px solid #dee2e6;
        }

        #pagination li.active a {
            background-color: #007bff;
            color: white;
            border-color: #007bff;
        }*/
