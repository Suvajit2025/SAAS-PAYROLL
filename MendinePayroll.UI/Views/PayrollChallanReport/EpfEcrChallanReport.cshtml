<script src="~/plugins/cdnjs/jquery.twbsPagination.min.js"></script>

<script>
    let ctcData = [];        // full data from API
    let filteredData = [];  // after filters
    let currentPage = 1;
    let pageSize = 10;
    let isPaginationInitialized = false;

    const $pagination = $('#pagination');
        totalRecords = 0,
        recPerPage = 10,
        totalPages = 0,
        currentPage = 1,
        pageSize = 10,
        isPaginationInitialized = false;

    $(document).ready(function () {
        $("#d1").hide();

        //loadEmployeeByFilters();
        initMultiSelects();
        loadFilters();
        //loadCTCReport();
        $('#searchInput').on('keyup', applyFilters);
        $('.multi-select').on('change', applyFilters);
        $('#btnClearFilters').on('click', clearFilters);


        if ($pagination.data('twbs-pagination')) {
            $pagination.twbsPagination('destroy');
        }

        $("#ddlmonth, #ddlyear, #EmployeeName").select2();
        reloadPFChallan(1);
    });

    function initMultiSelects() {
        $('.multi-select').multiselect({
            includeSelectAllOption: true,
            enableFiltering: true,
            enableCaseInsensitiveFiltering: true,
            maxHeight: 220,              // 🔑 fixed height
            buttonWidth: '100%',
            nonSelectedText: 'All',
            numberDisplayed: 1,
            buttonClass: 'btn btn-default btn-sm'
        });
    }

    function loadFilters() {
        loadDropdown('/SalaryCTC/GetCompanyList', '#ddlCompany', 'CompanyId', 'CompanyName');
        loadDropdown('/SalaryCTC/GetDepartmentList', '#ddlDepartment', 'DepartmentID', 'DepartmentName'); 

        loadEmployeeByFilters();
    }

    function loadDropdown(url, ddl, id, text) {
        $.getJSON(url, res => {
            const $ddl = $(ddl).empty();
            res.forEach(x => $ddl.append(`<option value="${x[id]}">${x[text]}</option>`));
            $ddl.multiselect('rebuild');
        });
    }
    //function loadCTCReport() {
    //    $.getJSON('/LoanReport/GetLoanLedgerReport', res => {
    //        ctcColumns = res.columns.filter(c => !hiddenColumns.includes(c));
    //        ctcColumns.unshift('Employee');


    //        ctcData = res.rows;
    //        filteredData = [...ctcData];
    //        buildHeader();
    //        paginate();
    //    });
    //}

    function loadEmployeeByFilters() {

        const companyIds = $('#ddlCompany').val() || [];
        const deptIds = $('#ddlDepartment').val() || [];
        const categoryIds = ['1'];   // MUST be array

        
        $.ajax({
            url: '/PayrollChallanReport/GetEmployeeList',
            type: 'GET',
            traditional: true,
            data: {
                companyIds: companyIds && companyIds.length ? companyIds : [''],
                deptIds: deptIds && deptIds.length ? deptIds : [''],
                categoryIds: ['1']
            },
            success: function (res) {


                const $ddl = $('#ddlEmployee');
                $ddl.empty();

                if (!Array.isArray(res)) {
                    console.error(res);
                    return;
                }

                res
                    .filter(x => x.Empstatus === 'ACTIVE')
                    .forEach(x => {
                        $ddl.append(
                            `<option value="${x.EmpID}">
                            ${x.EmpName} (${x.EmpCode})
                         </option>`
                        );
                    });

                $ddl.multiselect('rebuild');
            },
            error: function (xhr) {
                console.error("Server Error:", xhr.responseText);
                alert("Failed to load employee list");
            }
        });
    }


    function updatePagination() {

        $pagination.twbsPagination('destroy');

        let totalPages = Math.ceil(filteredData.length / pageSize);

        if (!totalPages) return;

        $pagination.twbsPagination({
            totalPages,
            startPage: currentPage,
            visiblePages: totalPages > 6 ? 6 : totalPages,
            initiateStartPageClick: false,
            onPageClick: function (e, page) {
                if (page !== currentPage) {
                    currentPage = page;
                    renderGrid();
                }
            }
        });
    }
    function clearFilters() {
        $('#searchInput').val('');
        $('.multi-select').multiselect('deselectAll', false)
            .multiselect('updateButtonText');

        filteredData = [...ctcData];
        currentPage = 1;
        renderGrid();
    }


    function renderGrid() {

        let start = (currentPage - 1) * pageSize;
        let pageData = filteredData.slice(start, start + pageSize);

        renderRows(pageData);
        updatePagination();
        updateTotals(pageData);
    }

    function updateTotals(rows) {

        let total = {
            GROSS_WAGES: 0,
            EPFWages: 0,
            EPSWages: 0,
            EDLIWages: 0,
            EPFRemitted: 0,
            EPSRemitted: 0,
            EPFEPSDIFF: 0,
            ADVANCES: 0
        };

        rows.forEach(r => {
            total.GROSS_WAGES += r.GROSS_WAGES || 0;
            total.EPFWages += r.EPFWages || 0;
            total.EPSWages += r.EPSWages || 0;
            total.EDLIWages += r.EDLIWages || 0;
            total.EPFRemitted += r.EPFRemitted || 0;
            total.EPSRemitted += r.EPSRemitted || 0;
            total.EPFEPSDIFF += r.EPFEPSDIFF || 0;
            total.ADVANCES += r.ADVANCES || 0;
        });

    //    $("#totalRow").html(`
    //    <tr style="background:#f0fdfa;font-weight:700">
    //        <td colspan="2" class="text-right">TOTAL</td>
    //        <td class="td-money">${total.GROSS_WAGES.toLocaleString('en-IN')}</td>
    //        <td class="td-money">${total.EPFWages.toLocaleString('en-IN')}</td>
    //        <td class="td-money">${total.EPSWages.toLocaleString('en-IN')}</td>
    //        <td class="td-money">${total.EDLIWages.toLocaleString('en-IN')}</td>
    //        <td class="td-money">${total.EPFRemitted.toLocaleString('en-IN')}</td>
    //        <td class="td-money">${total.EPSRemitted.toLocaleString('en-IN')}</td>
    //        <td class="td-money">${total.EPFEPSDIFF.toLocaleString('en-IN')}</td>
    //        <td></td>
    //        <td class="td-money">${total.ADVANCES.toLocaleString('en-IN')}</td>
    //    </tr>
    //`);
    }


    function applyFilters() {

        const search = $('#searchInput').val().toLowerCase();
        const companies = $('#ddlCompany').val() || [];
        const departments = $('#ddlDepartment').val() || [];
        const employees = $('#ddlEmployee').val() || [];

        
        filteredData = ctcData.filter(x => {

              const textMatch =
                !search ||
                  `${x.EmpId} ${x.CompanyName} ${x.DepartmentName}`
                    .toLowerCase()
                    .includes(search);

            const companyMatch =
                !companies.length || companies.includes(x.CompanyId.toString());

            const departmentMatch =
                !departments.length || departments.includes(x.DepartmentID.toString());

            const employeeMatch =
                !employees.length || employees.includes(x.EmpId);

            console.log(employeeMatch);

            return textMatch && companyMatch && departmentMatch && employeeMatch;
        });

        currentPage = 1;
        renderGrid();
    }

    function buildHeader() {
        let h = '<tr>';
        ctcColumns.forEach(c => {
            console.log(c);
            if (c === 'DepartmentName') {
                h += `<th class="${c === 'EmpName' ? 'col-emp' : ''}">Department Name</th>`;
            } else if (c === 'CompanyName') {
                h += `<th class="${c === 'EmpName' ? 'col-emp' : ''}">Company Name</th>`;
            } else if (c === 'LoanType') {
                h += `<th class="${c === 'EmpName' ? 'col-emp' : ''}">Loan Type</th>`;
            } else if (c === 'SanctionedAmount') {
                h += `<th class="${c === 'EmpName' ? 'col-emp' : ''}">Sanctioned Amount</th>`;
            } else if (c === 'TotalCreditAmount') {
                h += `<th class="${c === 'EmpName' ? 'col-emp' : ''}">Total Credit Amount</th>`;
            } else if (c === 'RunningBalance') {
                h += `<th class="${c === 'EmpName' ? 'col-emp' : ''}">Running Balance</th>`;
            } else if (c === 'LoanStatus') {
                h += `<th class="${c === 'EmpName' ? 'col-emp' : ''}">Loan Status</th>`;
            } else if (c === 'LoanDate') {
                h += `<th class="${c === 'EmpName' ? 'col-emp' : ''}">Loan Date</th>`;
            } else if (c === 'RepaymentStartMonthYear') {
                h += `<th class="${c === 'EmpName' ? 'col-emp' : ''}">Repayment Start Month Year</th>`;
            } else {
                h += `<th class="${c === 'EmpName' ? 'col-emp' : ''}">${c}</th>`;
            }

        });

        h += `<th class="text-right">Action</th>`;
        h += '</tr>';
        $('#ctcHead').html(h);
    }


    function paginate() {
        const start = (currentPage - 1) * pageSize;
        renderRows(filteredData.slice(start, start + pageSize));
        renderPagination(filteredData.length);
    }
    function renderRows(rows) {

        const $tbody = $("#users tbody").empty();

        let start = (currentPage - 1) * pageSize;   // ✅ FIX
        let end = start + rows.length;

        if (!rows.length) {
            $tbody.html(`
            <tr>
                <td colspan="11" class="text-center text-muted">
                    No records found
                </td>
            </tr>
        `);
            $("#Showing_no_Row").text("");
            return;
        }

        rows.forEach(r => {
            $tbody.append(`
            <tr>
                <td>${r.UAN ?? ''}</td>
                <td>${r.EmployeeName}</td>
                <td class="td-money">${r.GROSS_WAGES.toLocaleString('en-IN')}</td>
                <td class="td-money">${r.EPFWages.toLocaleString('en-IN')}</td>
                <td class="td-money">${r.EPSWages.toLocaleString('en-IN')}</td>
                <td class="td-money">${r.EDLIWages.toLocaleString('en-IN')}</td>
                <td class="td-money">${r.EPFRemitted.toLocaleString('en-IN')}</td>
                <td class="td-money">${r.EPSRemitted.toLocaleString('en-IN')}</td>
                <td class="td-money">${r.EPFEPSDIFF.toLocaleString('en-IN')}</td>
                <td>${r.NCPDays ?? 0}</td>
                <td class="td-money">${r.ADVANCES.toLocaleString('en-IN')}</td>
            </tr>
        `);
        });

        $("#Showing_no_Row").text(
            `Showing ${start + 1} to ${end} of ${filteredData.length} entries`
        );
    }

    function escapeHtml(t) {
        return t ? t.toString().replace(/[&<>"']/g, m =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[m])) : '';
    }
    // -------------------------------------------------------
    // Load PF Challan Data
    // -------------------------------------------------------
    function reloadPFChallan(page) {

        currentPage = page;

        let month = $("#ddlmonth").val();
        let year = $("#ddlyear").val();
        pageSize = parseInt($("#Pagrow").val());

        $.ajax({
            type: "POST",
            url: '/PayrollChallanReport/GetAllEmployeePFChallan',
            data: {
                Month: month,
                Year: year,
                numberofRow: pageSize,
                pagenumber: page
            },
            beforeSend: () => $("#progress").show(),
            success: function (data) {

                $("#progress").hide();
                $("#d1").show();

                if (!Array.isArray(data)) {
                    alert("Invalid data format");
                    return;
                }

                ctcData = data;
                applyFilters();   // dynamic filtering
            },
            error: () => {
                $("#progress").hide();
                alert("Error loading PF Challan data");
            }
        });
    }

    // -------------------------------------------------------
    // Pagination Logic — keeps highlight on correct page
    // -------------------------------------------------------
    function apply_pagination(totalRecords, pageSize) {
        $pagination.twbsPagination('destroy');

        var totalPages = Math.ceil(totalRecords / pageSize);
        var visible = totalPages > 10 ? 6 : totalPages;

        $pagination.twbsPagination({
            totalPages: totalPages,
            visiblePages: visible,
            startPage: currentPage,
            initiateStartPageClick: false,
            onPageClick: function (event, page) {
                if (page !== currentPage) {
                    currentPage = page;
                    reloadPFChallan(page);
                }
            }
        });
    }


    function clearFilters() {
        $('.multi-select').multiselect('deselectAll', false).multiselect('updateButtonText');
        $('#searchInput').val('');
        filteredData = [...ctcData];
        currentPage = 1;
        paginate();
    }

    // -------------------------------------------------------
    // When user changes number of rows per page
    // -------------------------------------------------------
    function GetSearchbypagenumberResult(page) {
        if ($pagination.data('twbs-pagination')) {
            $pagination.twbsPagination('destroy');
            isPaginationInitialized = false;
        }
        reloadPFChallan(page);
    }

    // -------------------------------------------------------
    // Export to CSV
    // -------------------------------------------------------
    function exportPFChallanToCSV() {
        var month = $("#ddlmonth").val();
        var year = $("#ddlyear").val();
        var empId = $("#EmployeeName").val();

        $("#progress").show();

        $.ajax({
            type: "POST",
            url: '/PayrollChallanReport/ExportPFChallanToCSV',
            data: { Month: month, Year: year, empParam: (empId == "0" || empId == "" ? null : empId) },
            success: function (fileName) {
                $("#progress").hide();

                if (fileName === "NODATA") {
                    alert("No data found for the selected filters.");
                    return;
                }

                const link = document.createElement("a");
                link.href = '/PayrollChallanReport/DownloadCsv?fileName=' + fileName;
                link.download = fileName;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            },
            error: function (xhr, status, error) {
                $("#progress").hide();
                alert("Error exporting CSV: " + error);
            }
        });
    }

